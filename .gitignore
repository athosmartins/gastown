# OS
.DS_Store
Thumbs.db

# Claude Code local state (but track commands/skills at the repo root only —
# nested .claude/ dirs, e.g. internal/*/.claude/, stay fully ignored below).
# NOTE: negating a path under an excluded parent dir doesn't work in gitignore
# (git won't recurse into an excluded dir to check deeper patterns), so this
# un-excludes the root .claude/ dir itself (root-anchored, leading /) before
# re-excluding its direct children and re-including commands/ and skills/.
.claude/
!/.claude/
/.claude/*
!/.claude/commands/
!/.claude/commands/**
!/.claude/skills/
!/.claude/skills/**

# ga-hnn7l: packaged TEMPLATE asset (staged into pool session workdirs at
# spawn time via agent overlay_dir), not local Claude Code session state —
# needs an explicit re-include like commands/skills above, since it's also
# nested under a .claude/ dir the blanket rule matches.
!.gascity-gastown-hq/packs/town-deltas/assets/claude-overlays/pool/.claude/
!.gascity-gastown-hq/packs/town-deltas/assets/claude-overlays/pool/.claude/settings.json

# Test
coverage.out
*.test
internal/events/*/

# Local config
config.toml
!config.example.toml
!internal/hooks/templates/vibe/config.toml
gt

# Runtime state (ignore contents, but allow setup-hooks to be tracked)
state.json
.runtime/
!.runtime/setup-hooks/
.crew-active-*

# Beads runtime state (not tracked)
# Formulas ARE tracked for `go install @latest` - see bottom of file
.beads/redirect
.beads/interactions.jsonl
.beads/metadata.json
.beads/mq/
.beads/last-touched
.beads/daemon-*.log.gz
.beads/.sync.lock
.beads/sync_base.jsonl
.beads/backup/
.beads-wisp/

# Clone-specific CLAUDE.md (regenerated locally per clone)
CLAUDE.md
# But keep the embedded template for gt doctor version checks
!internal/templates/townroot/claude.md

# Formulas: source of truth is internal/formula/formulas/ (embedded in binary).
# .beads/formulas/ is provisioned at runtime by gt install / gt doctor fix.

# Gas Town (added by gt)
# NOTE: .beads/ must NOT be blanket-ignored here — it blocks bd auto-export's
# `git add .beads` and silently breaks close-state persistence (gt-t5gii, 3rd
# regression). Runtime noise is ignored via the specific .beads/* entries above.
.logs/
logs/
settings/
.events.jsonl
.events.jsonl.lock
.sqlhistory
.fork-integration.json

# Nix build
result

# bv (beads viewer) local config and caches
.bv/

# Opencode
.opencode/

# Gas Town (added by gt)
__pycache__/

# Dolt database files (added by bd init)
.dolt/
*.db

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Gas Town (added by gt)
.runtime/
CLAUDE.local.md

# Fork research notes (private — not for public upstream)
docs/fork-info/

# Gas Town (added by gt)
GEMINI.md
.worktrees/
