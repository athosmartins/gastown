+// selfBlockedRootCloseStore reproduces the real beads store's close-policy
+// refusal (third_party/beads' "cannot close blocked issue") for closing
+// blockedID: it fails with a "... is blocked by [blockerID]" error for as
+// long as blockerID is still open in the wrapped store, and delegates
+// otherwise. addWorkflowRootDeps (internal/formula/compile.go) wires a
+// graph.v2 root's sole structural dependency to its auto-added
+// workflow-finalize step, so this is what the root's own close actually
+// sees in production every time - not a scripted one-shot failure - which
+// is why the fake checks live state instead of just counting calls.
+type selfBlockedRootCloseStore struct {
+	*beads.MemStore
+	blockedID, blockerID string
+}
+
+func (s *selfBlockedRootCloseStore) Update(id string, opts beads.UpdateOpts) error {
+	if id == s.blockedID && opts.Status != nil && *opts.Status == "closed" {
+		blocker, err := s.Get(s.blockerID)
+		if err != nil {
+			return err
+		}
+		if blocker.Status != "closed" {
+			return fmt.Errorf("cannot close blocked issue: %s is blocked by [%s]", s.blockedID, s.blockerID)
+		}
+	}
+	return s.MemStore.Update(id, opts)
+}
+
+// TestProcessWorkflowFinalizeRecoversWhenRootBlockedBySelf is the ga-3ef27l
+// regression: a graph.v2 root's only blocker is its own workflow-finalize
+// step, but the finalize step used to close itself LAST - so the root's
+// close always raced its own not-yet-closed finalizer and got quarantined
+// (control_dispatch_error), leaving the root dangling open+unassigned
+// forever. The fix must close the finalizer first so the retry succeeds.
+func TestProcessWorkflowFinalizeRecoversWhenRootBlockedBySelf(t *testing.T) {
+	t.Parallel()
+
+	mem := beads.NewMemStore()
+	workflow := mustCreateWorkflowBead(t, mem, beads.Bead{
+		Title: "workflow",
+		Type:  "task",
+		Metadata: map[string]string{
+			"gc.kind":             "workflow",
+			"gc.formula_contract": "graph.v2",
+		},
+	})
+	sink := mustCreateWorkflowBead(t, mem, beads.Bead{
+		Title:  "sink step",
+		Type:   "task",
+		Status: "closed",
+		Metadata: map[string]string{
+			"gc.outcome": "pass",
+		},
+	})
+	finalizer := mustCreateWorkflowBead(t, mem, beads.Bead{
+		Title: "Finalize workflow",
+		Type:  "task",
+		Metadata: map[string]string{
+			"gc.kind":         "workflow-finalize",
+			"gc.root_bead_id": workflow.ID,
+		},
+	})
+	mustDepAdd(t, mem, finalizer.ID, sink.ID, "blocks")
+	mustDepAdd(t, mem, workflow.ID, finalizer.ID, "blocks")
+
+	store := &selfBlockedRootCloseStore{MemStore: mem, blockedID: workflow.ID, blockerID: finalizer.ID}
+
+	result, err := ProcessControl(store, finalizer, ProcessOptions{})
+	if err != nil {
+		t.Fatalf("ProcessControl(workflow-finalize): %v", err)
+	}
+	if !result.Processed || result.Action != "workflow-pass" {
+		t.Fatalf("result = %+v, want processed workflow-pass", result)
+	}
+
+	rootAfter := mustGetBead(t, mem, workflow.ID)
+	if rootAfter.Status != "closed" {
+		t.Fatalf("workflow status = %q, want closed", rootAfter.Status)
+	}
+	if got := rootAfter.Metadata["gc.outcome"]; got != "pass" {
+		t.Fatalf("workflow outcome = %q, want pass", got)
+	}
+	finalizerAfter := mustGetBead(t, mem, finalizer.ID)
+	if finalizerAfter.Status != "closed" {
+		t.Fatalf("finalizer status = %q, want closed", finalizerAfter.Status)
+	}
+}
