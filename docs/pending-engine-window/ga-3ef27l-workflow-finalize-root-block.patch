+// isSelfBlockedCloseError reports whether err is the beads store's "cannot
+// close blocked issue" refusal with blockerID cited as (one of) the
+// blockers. String-matched, not errors.Is: the underlying sentinel
+// (third_party/beads' issueops.ErrCloseBlocked) lives in a different Go
+// module's internal/ package and is not importable from here - the same
+// constraint IsTransientControllerError's doc comment already notes for
+// wrapped store-boundary errors in general.
+func isSelfBlockedCloseError(err error, blockerID string) bool {
+	if err == nil || blockerID == "" {
+		return false
+	}
+	msg := err.Error()
+	return strings.Contains(msg, "blocked by") && strings.Contains(msg, blockerID)
