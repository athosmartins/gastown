+// TestProcessWorkflowFinalizeDoesNotRetryWhenRootBlockedByUnrelatedBead
+// guards the fix's scope: only a root-close refusal citing the finalize
+// bead ITSELF as blocker should trigger the close-finalizer-then-retry
+// recovery. A refusal citing some other bead is a genuine, unexpected
+// graph problem and must still hard-fail (and get quarantined by the
+// caller) exactly as before, not be silently retried.
+func TestProcessWorkflowFinalizeDoesNotRetryWhenRootBlockedByUnrelatedBead(t *testing.T) {
+	t.Parallel()
+
+	mem := beads.NewMemStore()
+	workflow := mustCreateWorkflowBead(t, mem, beads.Bead{
+		Title: "workflow",
+		Type:  "task",
+		Metadata: map[string]string{
+			"gc.kind":             "workflow",
+			"gc.formula_contract": "graph.v2",
+		},
+	})
+	finalizer := mustCreateWorkflowBead(t, mem, beads.Bead{
+		Title: "Finalize workflow",
+		Type:  "task",
+		Metadata: map[string]string{
+			"gc.kind":         "workflow-finalize",
+			"gc.root_bead_id": workflow.ID,
+		},
+	})
+
+	rootCloseErr := fmt.Errorf("cannot close blocked issue: %s is blocked by [some-other-bead]", workflow.ID)
+	store := updateErrorStore{Store: mem, failID: workflow.ID, err: rootCloseErr}
+
+	_, err := ProcessControl(store, finalizer, ProcessOptions{})
+	if err == nil {
+		t.Fatal("ProcessControl(workflow-finalize) err = nil, want root close failure")
+	}
+	if !strings.Contains(err.Error(), rootCloseErr.Error()) {
+		t.Fatalf("ProcessControl error = %v, want root close failure", err)
+	}
+	finalizerAfter := mustGetBead(t, mem, finalizer.ID)
+	if finalizerAfter.Status == "closed" {
+		t.Fatal("finalizer status = closed; want open - root is blocked by an unrelated bead, not itself, so no retry should have fired")
+	}
+}
