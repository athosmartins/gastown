#!/bin/bash
# Block pushes to arbitrary/unexpected branches. Gas Town agents push to the
# default branch (crew), polecat/* (polecats), integration/* (epics), or one
# of the crew-commit skill's conventional work-branch prefixes (fix/, feat/,
# refactor/, docs/, chore/, test/, crew/<name>/*) — the quality-gate-dispatcher
# auto-rebases and pushes these continuously as its normal merge mechanism.
#
# Also enforces integration branch landing guardrails: pushes to the default
# branch that introduce integration branch content are blocked unless
# GT_INTEGRATION_LAND=1 is set (only gt mq integration land sets this).
#
# Also blocks new/modified files under two outer-root (repo root) trees that
# shadow a canonical .gascity-gastown-hq/<path> equivalent, on ANY branch:
#   - packs/town-deltas/ — an orphan no launchd plist executes (only
#     .gascity-gastown-hq/packs/town-deltas/ is live) — a commit here
#     reviews and merges identically to the canonical tree but nothing ever
#     runs it. See ga-47sl.
#   - scripts/ — the git-worktree-nested-city-path trap: .gascity-gastown-hq
#     has no .git of its own, so `git worktree add` run from inside it roots
#     the new worktree at THIS outer repo, one level above the nested city —
#     a fix meant for the nested city's scripts/ silently lands in this
#     unrelated, separately-tracked outer tree instead. See ga-oj73m.
# Bypass (either tree): GT_SKIP_ORPHAN_TREE_GUARD=1.
#
# The deployed copy at .git/hooks/pre-push has a "BEGIN/END BEADS
# INTEGRATION" block appended after this section, managed independently by
# `bd`. This tracked file covers only the custom section above that block —
# the deployed copy must DROP this file's own trailing `exit 0` (see bottom)
# so control falls through into the beads block instead of returning early.
# core.hooksPath in this repo points at the plain .git/hooks/ location, NOT
# at .githooks/ — so editing this tracked file alone does not change live
# behavior; someone still has to re-deploy it into .git/hooks/pre-push by
# hand. This exact gap already bit the project once (ga-gdu3p) and that
# fix's own warning comment about it was itself later lost from this file
# (compare: no trace of ga-gdu3p survives here today even though `git log`
# still shows the commit that added it) — so re-losing this note again is a
# live, demonstrated risk, not a hypothetical one.

# Detect the rig's default branch dynamically.
# Fallback chain matches Go implementation (git.RemoteDefaultBranch):
# 1. origin/HEAD symref
# 2. origin/master (if it exists)
# 3. origin/main (final fallback)
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/origin/##')
if [[ -z "$default_branch" ]]; then
  if git rev-parse --verify origin/master &>/dev/null; then
    default_branch=master
  else
    default_branch=main
  fi
fi

# Allowed patterns:
#   <default_branch>, beads-sync  - Direct work branches
#   polecat/*                     - Polecat working branches (Refinery merges these)
#   integration/*                 - Integration branches (created by gt mq integration)
#   fix/*, feat/*, refactor/*,    - crew-commit skill's conventional work-branch
#   docs/*, chore/*, test/*         prefixes; also what quality-gate-dispatcher
#                                    auto-rebases and pushes as fix/* etc.
#   crew/*                        - Named-crew branches (crew/<name>/<bead>)

while read local_ref local_sha remote_ref remote_sha; do
  # Skip tags - they're allowed for releases
  if [[ "$remote_ref" == refs/tags/* ]]; then
    continue
  fi

  branch="${remote_ref#refs/heads/}"

  case "$branch" in
    "${default_branch}"|beads-sync|polecat/*|integration/*|fix/*|feat/*|refactor/*|docs/*|chore/*|test/*|crew/*)
      # Allowed branches
      ;;
    *)
      # Allow feature branches when contributing to upstream (fork workflow).
      # If an 'upstream' remote exists, this is a contribution setup where
      # feature branches are needed for PRs. See: #848
      if ! git remote get-url upstream &>/dev/null; then
        echo "ERROR: Invalid branch for Gas Town agents."
        echo ""
        echo "Blocked push to: $branch"
        echo ""
        echo "Allowed branches:"
        echo "  ${default_branch}        - Crew workers push here directly"
        echo "  polecat/*     - Polecat working branches"
        echo "  integration/* - Integration branches"
        echo "  beads-sync    - Beads synchronization"
        echo "  fix/*, feat/*, refactor/*, docs/*, chore/*, test/* - crew-commit work branches"
        echo "  crew/*        - Named-crew branches"
        echo ""
        echo "Do NOT create PRs. Push to main or let Refinery/gate-dispatcher merge work branches."
        exit 1
      fi
      ;;
  esac

  # Orphaned outer-root tree guard: reject new/modified files under any
  # outer-root (repo root) path that shadows a canonical
  # .gascity-gastown-hq/<path> equivalent, on any branch. Deletions are
  # allowed (cleanup out of the orphan tree is the eventual fix, not
  # blocked). Anchored at the start of each pathspec so the canonical
  # nested tree (.gascity-gastown-hq/<path>) never matches.
  #
  # check_orphan_path <pathspec> <bead> <reason...>: prints a BLOCKED
  # message and returns 1 if the current $orphan_range touches <pathspec>;
  # returns 0 silently otherwise. Relies on $orphan_range from the enclosing
  # scope (set fresh per ref-update below, before any call).
  check_orphan_path() {
    local pathspec="$1" bead="$2" reason="$3"
    local touch
    # Fail OPEN if the diff itself errors (e.g. shallow clone, missing
    # merge-base) -- this guard is new; a bug in it must not be able to
    # block every push in the city. Only a POSITIVE, confirmed match
    # blocks.
    touch=$(git diff --name-only --diff-filter=ACM "$orphan_range" -- "$pathspec" 2>/dev/null)
    if [[ -n "$touch" ]]; then
      echo "BLOCKED: push adds/modifies files under ${pathspec} (repo root)."
      echo ""
      echo "$reason"
      echo ""
      echo "Move these files to .gascity-gastown-hq/${pathspec} instead:"
      echo "$touch"
      echo ""
      echo "See $bead for full context. Deleting files from this tree is fine"
      echo "and not blocked -- only new adds/modifies are. One-off bypass:"
      echo "GT_SKIP_ORPHAN_TREE_GUARD=1 git push ..."
      return 1
    fi
    return 0
  }

  if [[ "$local_sha" != "0000000000000000000000000000000000000000" ]] && \
     [[ "$GT_SKIP_ORPHAN_TREE_GUARD" != "1" ]]; then
    if [[ "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
      orphan_range="$remote_sha..$local_sha"
    else
      orphan_range=""
      merge_base=$(git merge-base "$local_sha" "refs/remotes/origin/$default_branch" 2>/dev/null) && \
        orphan_range="$merge_base..$local_sha"
    fi
    if [[ -n "$orphan_range" ]]; then
      check_orphan_path 'packs/town-deltas/' 'ga-47sl' \
"This tree is ORPHANED -- no launchd plist executes it. The canonical
tree is .gascity-gastown-hq/packs/town-deltas/ (12 plists point there,
0 point at packs/town-deltas/). A commit here reviews and merges
identically to the canonical tree, but nothing ever runs it." || exit 1

      check_orphan_path 'scripts/' 'ga-oj73m' \
"This is very likely the git-worktree-nested-city-path trap:
.gascity-gastown-hq has no .git of its own, so \`git worktree add\` run from
inside it roots the new worktree at THIS outer repo -- a fix meant for the
nested city's scripts/ silently lands in this unrelated, separately-tracked
outer tree instead. Every commit that touched this outer path in the 30
days before this guard shipped was exactly this accident, not legitimate
outer-repo work; the deployed tree agents actually run from is
.gascity-gastown-hq/scripts/." || exit 1
    fi
  fi

  # Integration branch landing guardrail: when pushing to the default branch,
  # check if any integration branch tip is newly reachable from this push.
  # This catches merges (--no-ff, --ff-only, default) and rebases.
  # Only cherry-picks (new SHAs) are not detected — Layer 1 covers those.
  if [[ "$branch" == "$default_branch" ]] && [[ "$GT_INTEGRATION_LAND" != "1" ]]; then
    # Skip for deletions or initial pushes
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]] || \
       [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
      continue
    fi
    # Check if any integration branch tip is newly reachable from this push.
    # Use ls-remote instead of for-each-ref to avoid false positives from stale
    # local tracking refs that may linger after branch deletion.
    # Fail closed: if ls-remote fails (network error), block the push rather than
    # silently allowing unverified integration branch content through.
    integration_refs=$(git ls-remote --quiet origin "refs/heads/integration/*" 2>&1) || {
      echo "WARNING: Cannot verify integration branches (remote unreachable)."
      echo "Push to $default_branch blocked. Retry when network is available,"
      echo "or set GT_INTEGRATION_LAND=1 if this is an intentional land operation."
      exit 1
    }
    for ref in $(echo "$integration_refs" | awk '{print $1}'); do
      if git merge-base --is-ancestor "$ref" "$local_sha" && \
         ! git merge-base --is-ancestor "$ref" "$remote_sha"; then
        echo "BLOCKED: Push to $default_branch introduces integration branch content."
        echo ""
        echo "Integration branches must be landed via: gt mq integration land <epic-id>"
        echo ""
        echo "This guardrail prevents accidental landing of integration branches."
        echo "The gt mq integration land command sets GT_INTEGRATION_LAND=1 to bypass this check."
        exit 1
      fi
    done
  fi
done

exit 0
