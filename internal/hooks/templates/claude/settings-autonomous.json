{
  "skipDangerousModePermissionPrompt": true,
  "hasCompletedOnboarding": true,
  "theme": "dark",
  "editorMode": "normal",
  "feedbackSurveyRate": 0,
  "awaySummaryEnabled": false,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": ["mcp__plugin_github_github__create_pull_request"]
  },
  "enabledPlugins": {
    "beads@beads-marketplace": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard pr-workflow",
            "if": "Bash(gh pr create*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard pr-workflow",
            "if": "Bash(git checkout -b*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard pr-workflow",
            "if": "Bash(git switch -c*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard cross-clone-block",
            "if": "Bash(git*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard dangerous-command",
            "if": "Bash(sudo *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard dangerous-command",
            "if": "Bash(apt install*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard dangerous-command",
            "if": "Bash(apt-get install*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard dangerous-command",
            "if": "Bash(dnf install*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard dangerous-command",
            "if": "Bash(yum install*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard dangerous-command",
            "if": "Bash(pacman -S*)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} tap guard dangerous-command",
            "if": "Bash(brew install*)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} prime --hook"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} prime --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "case \"${GT_ROLE:-}\" in *witness*|*refinery*|deacon*|*boot*) exit 0 ;; *) {{GT_BIN}} mail check --inject ;; esac"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{GT_BIN}} costs record &"
          }
        ]
      }
    ]
  }
}
