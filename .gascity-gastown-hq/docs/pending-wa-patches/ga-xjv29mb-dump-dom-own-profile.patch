     """
+    profile = None
+    own_flags = []
+    if not any(f.startswith("--user-data-dir") for f in extra_flags):
+        profile = tempfile.mkdtemp(prefix="dump_dom_profile_")
+        own_flags = ["--user-data-dir=" + profile, "--incognito"]
     cmd = [chrome_path, "--headless=new", "--disable-gpu", "--no-sandbox",
-           *extra_flags, "--dump-dom", url]
-    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+           *own_flags, *extra_flags, "--dump-dom", url]
+    try:
