+fail() { echo "[prod-test:gascity ga-dzzqvw.1] FAIL: $*" >&2; exit 1; }
+for f in "$TALLY" "$A/gate-lane-tally.selftest.sh" "$A/gate-taskrapida.lib.sh" "$A/gate-taskrapida.selftest.sh"; do [[ -f "$f" ]] || fail "missing: $f"; done
