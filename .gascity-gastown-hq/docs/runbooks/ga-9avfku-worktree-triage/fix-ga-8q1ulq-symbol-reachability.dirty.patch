+# fixture): TWO GUARDED daemons. zzz-target's closure covers lib/shared_lib.py,
+# which is THIS bead's own commit (BASE..BEAD_POST); aaa-decoy's closure covers
+# lib/other_lib.py, which only a DIFFERENT, later bystander commit touches
+# (BEAD_POST..WIDE_POST) — same "own narrow commit vs. wide-window bystander"
+# shape as wa-ut5lc's real conversation-monitor case. Named so aaa (alphabetic
+# default order) sorts BEFORE zzz — a correct reorder is the ONLY way the
+# bead's-own daemon gets processed first. Both take 4s to answer (seeded delay)
+# against a 3s total budget, so only ONE fits per sweep.
+#
+# Sweep 1: zzz-target (bead's own) must be attempted FIRST and land CONFIRMED;
+# aaa-decoy must be skipped WITHOUT the calculator ever running for it (proof
+# it was budget-skipped, not attempted-and-failed) and land NÃO CALCULADO.
+# Sweep 2, SAME window (the halt looping on an unmerged fix, exactly as it
+# does in production — no new commits between sweeps): zzz-target must answer
+# from CACHE (call count stays at 1 — never recomputed), freeing the entire
+# budget for aaa-decoy, which now completes and lands CONFIRMED too. This is
+# the exact wa-v5ya9 shape: the daemon that matters ends SYMBOL-CONFIRMED,
+# never stuck at NÃO CALCULADO just because a sibling daemon happened to run
+# first.
+# ════════════════════════════════════════════════════════════════════════════
+new_case t70
+make_symbol_script "$RUNTIME"
+cat > "$RUNTIME/daemons/aaa_decoy.py" <<<'print("decoy")'
+cat > "$RUNTIME/daemons/zzz_target.py" <<<'print("target")'
+mkdir -p "$RUNTIME/lib"
+cat > "$RUNTIME/lib/shared_lib.py" <<<'def helper(): pass'
+cat > "$RUNTIME/lib/other_lib.py" <<<'def other(): pass'
+cat > "$RUNTIME/daemons/deploy_deps.json" <<'JSONEOF'
+{
+  "_generated_by": "scripts/gen_daemon_deps.py",
+  "daemons": {
+    "daemons/aaa_decoy.py": {
+      "label": "com.test.aaa-decoy",
+      "closure": ["daemons/aaa_decoy.py", "lib/other_lib.py"]
+    },
+    "daemons/zzz_target.py": {
+      "label": "com.test.zzz-target",
+      "closure": ["daemons/zzz_target.py", "lib/shared_lib.py"]
+    }
+  }
+}
+JSONEOF
+make_plist "$AGENTS" com.test.aaa-decoy "$RUNTIME/venv/bin/python3" "$RUNTIME/daemons/aaa_decoy.py"
+make_plist "$AGENTS" com.test.zzz-target "$RUNTIME/venv/bin/python3" "$RUNTIME/daemons/zzz_target.py"
+seed_running com.test.aaa-decoy 70001 "$STALE_LSTART"
+seed_running com.test.zzz-target 70101 "$STALE_LSTART"
+seed_symbol_result daemons/aaa_decoy.py confirmed
+seed_symbol_delay daemons/aaa_decoy.py 4
+seed_symbol_result daemons/zzz_target.py confirmed
+seed_symbol_delay daemons/zzz_target.py 4
+SENSITIVE_DAEMONS="aaa-decoy zzz-target"
+
+# BASE -> T70_BEAD_POST is THIS bead's own commit (lib/shared_lib.py only).
+# T70_BEAD_POST -> T70_WIDE_POST is a bystander commit from a DIFFERENT bead
+# (lib/other_lib.py only) — mirrors wa-ut5lc's real shape exactly.
+( cd "$RUNTIME"; git add -A >/dev/null 2>&1; git commit -q -m base --allow-empty )
+T70_PRE=$(git -C "$RUNTIME" rev-parse HEAD)
+echo "# bead's own change" >> "$RUNTIME/lib/shared_lib.py"
+( cd "$RUNTIME"
+  git add -A >/dev/null 2>&1
+  GIT_AUTHOR_DATE="@$POST_COMMIT_EPOCH" GIT_COMMITTER_DATE="@$POST_COMMIT_EPOCH" \
+    git commit -q -m "bead's own merge" --allow-empty )
+T70_BEAD_POST=$(git -C "$RUNTIME" rev-parse HEAD)
+echo "# bystander change" >> "$RUNTIME/lib/other_lib.py"
+( cd "$RUNTIME"
+  git add -A >/dev/null 2>&1
+  GIT_AUTHOR_DATE="@$POST_COMMIT_EPOCH" GIT_COMMITTER_DATE="@$POST_COMMIT_EPOCH" \
+    git commit -q -m bystander --allow-empty )
+T70_WIDE_POST=$(git -C "$RUNTIME" rev-parse HEAD)
+
+run_t70_sweep() {
+  MOCK_DIR="$MOCK" RUNTIME_DIR="$RUNTIME" \
+    PRE_DEPLOY_SHA="$T70_PRE" POST_DEPLOY_SHA="$T70_WIDE_POST" \
+    BEAD_MERGE_PRE_SHA="$T70_PRE" BEAD_MERGE_SHA="$T70_BEAD_POST" \
+    DEPLOY_EPOCH="$DEPLOY_EPOCH" SENSITIVE_DAEMONS="$SENSITIVE_DAEMONS" \
+    EXTRA_RUNTIME_ROOTS="" FORCE_RESTART_LABELS="" \
+    LAUNCH_AGENTS_DIR="$AGENTS" LAUNCHCTL_BIN="$BIN/launchctl" PS_BIN="$BIN/ps" \
+    VERIFY_TIMEOUT=2 VERIFY_INTERVAL=0.2 \
+    SYMBOL_REACHABILITY_TIMEOUT=10 SYMBOL_REACHABILITY_TOTAL_TIMEOUT=3 \
+    DRY_RUN=0 bash "$HELPER" 2>/dev/null
+}
+
+SWEEP1=$(run_t70_sweep); RC=$?
+V1=$(field VERDICT "$SWEEP1")
+[ "$V1" = "NEEDS_GUARDED_RESTART" ] && ok "T70 sweep1 verdict NEEDS_GUARDED_RESTART" || nok "T70 sweep1 verdict" "got '$V1' out=[$SWEEP1]"
+for l in com.test.aaa-decoy com.test.zzz-target; do
+  echo "$(field GUARDED "$SWEEP1")" | grep -q "$l" && ok "T70 sweep1 $l in flat GUARDED" || nok "T70 sweep1 guarded $l" "$(field GUARDED "$SWEEP1")"
+done
+echo "$(field GUARDED_SYMBOL_CONFIRMED "$SWEEP1")" | grep -q "com.test.zzz-target" \
+  && ok "T70 sweep1: bead's-own-affected daemon (zzz-target) processed first and CONFIRMED, not starved by the decoy" \
+  || nok "T70 sweep1 zzz-target" "$(field GUARDED_SYMBOL_CONFIRMED "$SWEEP1")"
+echo "$(field GUARDED_SYMBOL_NOT_COMPUTED "$SWEEP1")" | grep -q "com.test.aaa-decoy" \
+  && ok "T70 sweep1: decoy correctly deferred to NÃO CALCULADO (whole budget spent on the priority daemon first)" \
+  || nok "T70 sweep1 aaa-decoy" "$(field GUARDED_SYMBOL_NOT_COMPUTED "$SWEEP1")"
+[ "$(symbol_call_count daemons/aaa_decoy.py)" = "0" ] \
+  && ok "T70 sweep1: decoy's calculator never invoked at all (proves SKIPPED by the budget guard, not attempted-and-timed-out)" \
+  || nok "T70 sweep1 decoy call count" "expected 0, got $(symbol_call_count daemons/aaa_decoy.py)"
+
+SWEEP2=$(run_t70_sweep); RC=$?
+V2=$(field VERDICT "$SWEEP2")
+[ "$V2" = "NEEDS_GUARDED_RESTART" ] && ok "T70 sweep2 verdict NEEDS_GUARDED_RESTART" || nok "T70 sweep2 verdict" "got '$V2' out=[$SWEEP2]"
+echo "$(field GUARDED_SYMBOL_CONFIRMED "$SWEEP2")" | grep -q "com.test.zzz-target" \
+  && ok "T70 sweep2: zzz-target still CONFIRMED (now answered from cache)" \
+  || nok "T70 sweep2 zzz-target" "$(field GUARDED_SYMBOL_CONFIRMED "$SWEEP2")"
+[ "$(symbol_call_count daemons/zzz_target.py)" = "1" ] \
+  && ok "T70 sweep2: zzz-target's calculator called exactly ONCE total across both sweeps (sweep2 was a cache hit, not a recompute)" \
+  || nok "T70 sweep2 zzz-target call count" "expected 1 (cached on sweep2), got $(symbol_call_count daemons/zzz_target.py)"
+echo "$(field GUARDED_SYMBOL_CONFIRMED "$SWEEP2")" | grep -q "com.test.aaa-decoy" \
+  && ok "T70 sweep2: decoy now CONFIRMED too — the cache hit on zzz-target freed the budget it needed. This is the wa-v5ya9 shape: the daemon that matters never stays stuck at NÃO CALCULADO." \
+  || nok "T70 sweep2 aaa-decoy" "$(field GUARDED_SYMBOL_CONFIRMED "$SWEEP2")"
+
 # ── summary ───────────────────────────────────────────────────────────────────
 echo ""
 echo "daemon-refresh tests: $PASS passed, $FAIL failed"
