diff --git a/internal/types/label_inherit.go b/internal/types/label_inherit.go
new file mode 100644
index 000000000..67221b19e
--- /dev/null
+++ b/internal/types/label_inherit.go
@@ -0,0 +1,91 @@
+package types
+
+import "strings"
+
+// Labels a child never inherits from its parent (ga-y5z6hzh, ga-2svou8).
+//
+// `bd create --parent` copies the parent's labels onto the new child. Some of
+// them classify the work (area:*, lane:*, node:*, framework:*, origem:*) and are
+// worth carrying down. The rest record where ONE specific bead stands in a
+// process: a gate verdict, a retry counter, a refusal, a delivery status, a
+// "done" or "in flight" mark. A child born with those reads as if it had already
+// been through the process, so a brand-new slice of a closed parent shows up as
+// finished (gate:passed, story:done) or parked (exec:manual, pilot:*) without
+// any work having happened, and the dispatcher skips it in silence.
+//
+// Rule of thumb for adding to the lists: would the label be TRUE of a bead that
+// was created one second ago under this parent? If not, it is state.
+//
+// The match is on the label NAMESPACE (a literal prefix, case-sensitive), not a
+// substring: "gates:review", "mygate:x" and a bare "pilot" are unrelated labels
+// and keep being inherited.
+var nonInheritableLabelPrefixes = []string{
+	"gate:",        // gate verdicts and counters: gate:passed, gate:fix-attempt:N, gate:needs-human:*
+	"gate-",        // gate memos keyed by sha/run: gate-approved:<sha>, gate-sha-failed:<sha>:*, gate-status:*
+	"pilot:",       // dispatcher bookkeeping: no-auto-dispatch, held*, reclaim/refusal counters, refused-reason
+	"pool:",        // pool refusals (pool:refused:*)
+	"lifecycle:",   // lifecycle flags such as lifecycle:label-conflict
+	"delivery:",    // delivery status: delivery:tested, delivery:partial, delivery:failed
+	"next-action:", // who owns the next move on THIS bead
+	"blocked:",     // blockers of this bead
+	"blocked-",     // blocked-on:<id>, blocked-reason:<why>
+	"audit:",       // post-merge audit state
+	"auto-refino:", // refiner progress on this bead
+	"refino:",      // refiner verdicts on this bead
+	"impacto:",     // live-damage mark, backed by evidence about one specific bead
+}
+
+// nonInheritableLabels are single labels (not a family) with the same problem.
+var nonInheritableLabels = map[string]struct{}{
+	"exec:manual":          {}, // "a human runs this one by hand" - about the parent
+	"needs-human":          {},
+	"needs-human-decision": {},
+	"ctx:thin":             {},
+	"scope:needs-review":   {},
+}
+
+// The story: namespace is the story lifecycle (done, gate, in-flight,
+// epic-split, ...). It is blocked as a whole and only these labels, which arm or
+// classify the work rather than record progress, may be inherited. A story:
+// state added later is therefore NOT inherited until someone lists it here:
+// a child missing a label is a one-line fix, a child carrying a stale state
+// label vanishes from the dispatcher.
+const storyNamespace = "story:"
+
+var inheritableStoryLabels = map[string]struct{}{
+	"story:approved":     {},
+	"story:unrefined":    {},
+	"story:needs-refino": {},
+	"story:needs-device": {},
+}
+
+// IsInheritableLabel reports whether a label may be copied from a parent onto a
+// new child. It governs INHERITANCE only: a label the caller asks for by name is
+// never filtered, so `--labels gate:queued` still works.
+func IsInheritableLabel(label string) bool {
+	if _, blocked := nonInheritableLabels[label]; blocked {
+		return false
+	}
+	if strings.HasPrefix(label, storyNamespace) {
+		_, allowed := inheritableStoryLabels[label]
+		return allowed
+	}
+	for _, prefix := range nonInheritableLabelPrefixes {
+		if strings.HasPrefix(label, prefix) {
+			return false
+		}
+	}
+	return true
+}
+
+// FilterInheritableLabels returns the labels that may be inherited, in their
+// original order. It never aliases the input; a nil result means none survive.
+func FilterInheritableLabels(labels []string) []string {
+	var kept []string
+	for _, label := range labels {
+		if IsInheritableLabel(label) {
+			kept = append(kept, label)
+		}
+	}
+	return kept
+}
diff --git a/internal/types/label_inherit_test.go b/internal/types/label_inherit_test.go
new file mode 100644
index 000000000..19bd33e3e
--- /dev/null
+++ b/internal/types/label_inherit_test.go
@@ -0,0 +1,123 @@
+package types
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestIsInheritableLabel(t *testing.T) {
+	cases := []struct {
+		label string
+		want  bool
+	}{
+		// ga-y5z6hzh: the cycle labels a slice of a CLOSED parent was born with
+		// (wa-93uf5c.4/.5, wa-zmxywv.30.1, wa-xmpoab.2.1, ga-2hd02v.3.x).
+		{"gate:passed", false},
+		{"story:done", false},
+		{"story:gate", false},
+		{"gate-approved:0123456789abcdef0123456789abcdef01234567", false},
+		{"exec:manual", false},
+		{"pilot:reclaim-count:1", false},
+		{"pilot:no-auto-dispatch", false},
+		{"story:epic-split", false},
+
+		// ga-2svou8: a slice of a parent the gate had failed.
+		{"gate:failed", false},
+		{"gate:fix-attempt:2", false},
+		{"gate:needs-fix", false},
+		{"gate:needs-human", false},
+		{"gate:needs-human:technical", false},
+		{"gate-sha-failed:48d62592411a65c77aca2ef29224faa651664593:code", false},
+		{"lifecycle:label-conflict", false},
+		{"pilot:refused-reason:umbrella-sliced-owned-by-live-crew", false},
+		{"story:needs-human", false},
+
+		// The rest of the process-state families the dispatcher keys on.
+		{"gate:queued", false},
+		{"gate:nonblocking-findings", false},
+		{"gate-status:passed", false},
+		{"pilot:held-until:1793313976", false},
+		{"pool:refused:engine-rebuild-required", false},
+		{"delivery:tested", false},
+		{"delivery:partial", false},
+		{"next-action:mayor", false},
+		{"next-action:athos-decide", false},
+		{"blocked:engine-window", false},
+		{"blocked-on:ga-3azujf", false},
+		{"blocked-reason:decision", false},
+		{"audit:pending", false},
+		{"auto-refino:refining", false},
+		{"refino:info-gap", false},
+		{"impacto:dano-ao-vivo", false},
+		{"needs-human", false},
+		{"needs-human-decision", false},
+		{"ctx:thin", false},
+		{"scope:needs-review", false},
+		{"story:in-flight", false},
+		{"story:epic", false},
+		{"story:blocked", false},
+		{"story:cancelled", false},
+		{"story:awaiting-external-merge", false},
+		{"story:needs-approval", false},
+		{"story:refinement-in-progress", false},
+		{"story:refino-review", false},
+		{"story:refino-escalado", false},
+		// A story: state nobody has listed yet must NOT leak down.
+		{"story:some-state-added-next-month", false},
+
+		// Classification: still inherited.
+		{"area:infra", true},
+		{"lane:small", true},
+		{"node:never", true},
+		{"framework:engine", true},
+		{"scope:advisory", true},
+		{"origem:athos", true},
+		{"ctx:ready", true},
+		{"exec:auto", true},
+		{"needs:engine-window", true},
+		{"waiting-on:janela-engine", true},
+		{"followup:nonblocking", true},
+		{"story:approved", true},
+		{"story:unrefined", true},
+		{"story:needs-refino", true},
+		{"story:needs-device", true},
+
+		// Prefix families, not substrings: look-alikes keep being inherited.
+		{"gates:review", true},
+		{"mygate:failed", true},
+		{"Gate:failed", true},
+		{"gate", true},
+		{"pilot", true},
+		{"lifecycle", true},
+		{"deliveryx:y", true},
+		{"unblocked:yes", true},
+		{"stories:x", true},
+		{"story", true},
+		{"exec:manual-review", true},
+		{"", true},
+	}
+	for _, tc := range cases {
+		if got := IsInheritableLabel(tc.label); got != tc.want {
+			t.Errorf("IsInheritableLabel(%q) = %v, want %v", tc.label, got, tc.want)
+		}
+	}
+}
+
+func TestFilterInheritableLabels(t *testing.T) {
+	in := []string{"lane:small", "gate:passed", "area:infra", "story:done", "exec:manual", "ctx:ready"}
+	got := FilterInheritableLabels(in)
+	want := []string{"lane:small", "area:infra", "ctx:ready"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("FilterInheritableLabels = %v, want %v", got, want)
+	}
+	if !reflect.DeepEqual(in, []string{"lane:small", "gate:passed", "area:infra", "story:done", "exec:manual", "ctx:ready"}) {
+		t.Fatalf("input was mutated: %v", in)
+	}
+
+	if got := FilterInheritableLabels([]string{"gate:passed", "story:done"}); got != nil {
+		t.Fatalf("all-state input = %v, want nil", got)
+	}
+	if got := FilterInheritableLabels(nil); got != nil {
+		t.Fatalf("nil input = %v, want nil", got)
+	}
+}
