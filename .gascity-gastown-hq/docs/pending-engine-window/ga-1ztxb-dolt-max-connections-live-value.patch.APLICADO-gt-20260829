+// getLiveMaxConnections queries the running Dolt server for its actual configured
+// max_connections system variable. Uses `dolt sql` (same technique as
+// GetActiveConnectionCount) to avoid a MySQL driver dependency. Returns an error if
+// the server is unreachable or the query fails — callers must fall back to the
+// static Config.MaxConnections default in that case (ga-1ztxb: Config.MaxConnections
+// is a compile-time default that is never updated from the live server, so it silently
+// diverges from reality whenever a town's actual max_connections isn't the Dolt
+// default of 1000 — see the sibling bug ga-ood0l for the same defect class).
+func getLiveMaxConnections(townRoot string) (int, error) {
+	config := DefaultConfig(townRoot)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+
+	fullArgs := []string{
+		"--host", config.EffectiveHost(),
+		"--port", strconv.Itoa(config.Port),
+		"--user", config.User,
+		"--no-tls",
+		"sql",
+		"-r", "csv",
+		"-q", "SELECT @@max_connections AS max_conn",
+	}
+	cmd := exec.CommandContext(ctx, "dolt", fullArgs...)
+	// GH#2537: see GetActiveConnectionCount above — set cmd.Dir to the server's
+	// data directory to prevent dolt from creating stray .doltcfg/privileges.db
+	// files in the caller's CWD, even in TCP client mode.
+	cmd.Dir = config.DataDir
+	cmd.Env = append(os.Environ(), "DOLT_CLI_PASSWORD="+config.Password)
+	setProcessGroup(cmd)
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		return 0, fmt.Errorf("querying max_connections: %w (output: %s)", err, strings.TrimSpace(string(output)))
+	}
+	return parseMaxConnectionsOutput(output)
+}
+
+// parseMaxConnectionsOutput parses the CSV output of a `SELECT @@max_connections`
+// query (e.g. "max_conn\n256\n") into an integer. Split out from
+// getLiveMaxConnections so the parsing logic is unit-testable without a live Dolt
+// server.
+func parseMaxConnectionsOutput(output []byte) (int, error) {
+	lines := strings.Split(strings.TrimSpace(string(output)), "\n")
+	if len(lines) < 2 {
+		return 0, fmt.Errorf("unexpected output from max_connections query: %s", string(output))
+	}
+	count, err := strconv.Atoi(strings.TrimSpace(lines[len(lines)-1]))
+	if err != nil {
+		return 0, fmt.Errorf("parsing max_connections %q: %w", lines[len(lines)-1], err)
+	}
+	return count, nil
+}
