+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/gastownhall/gascity/internal/citylayout"
+)
+
+// ga-znmm7w1: the builtin worker prompts (the ones an engine-synthesized <rig>/claude-headless agent runs on) tell the agent to claim
+// with `bd update <id> --claim` and then to check that "the assignee must be $GC_SESSION_NAME". A claim is recorded under the bd
+// ACTOR, and the engine stamps BEADS_ACTOR with the pool slot ALIAS (setTemplateEnvIdentity), so the claim never landed on the
+// session: the worker refused the bead it had just won and drained (wa-fj2lqh, 19/11: 5 sessions in ~35 min, 0 commits, each ended by
+// "drain acknowledged"). The engine's own scripted claim already passes `--actor $GC_SESSION_NAME` first (agentScriptClaimActor);
+// these tests hold the prompt text to the same identity.
+
+const claimActorFlag = `--actor "$GC_SESSION_NAME"`
+
+type builtinWorkerPrompt struct{ name, text string }
+
+// builtinWorkerPromptsForClaimTest returns the three texts a session without its own prompt_template can be primed with: the compiled-in
+// fallback and the two core-pack prompts, read the way the binary ships them (materialized from the embedded pack).
+func builtinWorkerPromptsForClaimTest(t *testing.T) []builtinWorkerPrompt {
+	t.Helper()
+	dir := t.TempDir()
+	if err := MaterializeBuiltinPacks(dir); err != nil {
+		t.Fatalf("MaterializeBuiltinPacks() error: %v", err)
+	}
+	out := []builtinWorkerPrompt{{"defaultPrimePrompt", defaultPrimePrompt}}
+	for _, name := range []string{"pool-worker.template.md", "graph-worker.template.md"} {
+		path := filepath.Join(dir, citylayout.SystemPacksRoot, "core", "assets", "prompts", name)
+		// vazio → the test fails below (no claim command found); falhou/ilegível → Fatalf: a prompt that cannot be read proves nothing.
+		data, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatalf("ReadFile(%s): %v", path, err)
+		}
+		out = append(out, builtinWorkerPrompt{name: name, text: string(data)})
+	}
+	return out
+}
+
+// claimCommandRE finds every `bd update <id> --claim ...` the prompt tells the agent to run or documents: from "bd update" to the
+// first backtick, ';' or end of line after it.
+var claimCommandRE = regexp.MustCompile("bd update <id> --claim[^`;\n]*")
+
+func claimCommandsIn(text string) []string {
+	var out []string
+	for _, m := range claimCommandRE.FindAllString(text, -1) {
+		out = append(out, strings.TrimSpace(m))
+	}
+	return out
+}
+
+func TestBuiltinWorkerPromptsClaimAsSessionActor(t *testing.T) {
+	for _, p := range builtinWorkerPromptsForClaimTest(t) {
+		t.Run(p.name, func(t *testing.T) {
+			cmds := claimCommandsIn(p.text)
+			if len(cmds) == 0 {
+				t.Fatalf("no `bd update <id> --claim` command found: the test cannot say what the prompt tells the agent to run")
+			}
+			for _, c := range cmds {
+				if !strings.Contains(c, claimActorFlag) {
+					t.Errorf("claim command %q does not carry %s: the claim would be recorded under $BEADS_ACTOR (the pool slot alias) and the prompt's own verification (the assignee must be $GC_SESSION_NAME) would refuse the bead", c, claimActorFlag)
+				}
+			}
+		})
+	}
+}
+
+// The verification half of the pair: the prompts check the claim against the SESSION name. The claim above must keep recording that
+// same identity; if a future edit loosens the check instead, this test says the pair changed and the claim line must be re-read.
+func TestBuiltinWorkerPromptsVerifyTheClaimAgainstTheSessionName(t *testing.T) {
+	re := regexp.MustCompile(`(?i)assign[^\n]*\$GC_SESSION_NAME`)
+	for _, p := range builtinWorkerPromptsForClaimTest(t) {
+		if !re.MatchString(p.text) {
+			t.Errorf("%s: no line ties the assignee to $GC_SESSION_NAME any more: the claim identity (%s) and the verification must name the same thing", p.name, claimActorFlag)
+		}
+	}
+}
+
+// fakeBdForClaim stands in for bd's claim: it records the actor the real bd would write as the assignee. bd resolves that actor as
+// `--actor` flag > $BEADS_ACTOR > $BD_ACTOR (third_party/beads/cmd/bd/main.go, getActorWithGit), and `bd update --claim` hands it to
+// ClaimIssueInTx as the new assignee (internal/storage/issueops/claim.go).
+const fakeBdForClaim = `#!/bin/sh
+actor=""; claim=0
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --claim) claim=1 ;;
+    --actor) shift; actor="$1" ;;
+    --actor=*) actor="${1#--actor=}" ;;
+  esac
+  shift
+done
+[ "$claim" = 1 ] || exit 2
+[ -n "$actor" ] || actor="${BEADS_ACTOR:-${BD_ACTOR:-}}"
+printf '%s' "$actor" > "$FAKE_BD_OUT"
+`
+
+func TestBuiltinWorkerPromptClaimCommandRecordsTheSession(t *testing.T) {
+	const (
+		alias   = "whatsapp_automation/claude-headless-1"
+		session = "claude-headless-ga7bku77s"
+	)
+	binDir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(binDir, "bd"), []byte(fakeBdForClaim), 0o755); err != nil {
+		t.Fatalf("WriteFile(fake bd): %v", err)
+	}
+	outFile := filepath.Join(t.TempDir(), "assignee")
+	// A pool slot as the engine stamps it: BEADS_ACTOR and GC_ALIAS are the alias, GC_SESSION_NAME is the incarnation.
+	runClaim := func(t *testing.T, command string) string {
+		t.Helper()
+		_ = os.Remove(outFile)
+		// The command text is the repo's own prompt text (an embedded constant / embedded pack file), never external input. It goes
+		// through a shell on purpose: the agent's shell expands "$GC_SESSION_NAME" in that text, and that expansion is what is under test.
+		cmd := exec.Command("sh", "-c", command)
+		cmd.Env = []string{
+			"PATH=" + binDir + ":" + os.Getenv("PATH"),
+			"BEADS_ACTOR=" + alias, "GC_ALIAS=" + alias, "GC_AGENT=" + alias,
+			"GC_SESSION_NAME=" + session, "GC_TEMPLATE=whatsapp_automation/claude-headless",
+			"FAKE_BD_OUT=" + outFile,
+		}
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("running %q: %v\n%s", command, err, out)
+		}
+		// vazio → "" (the fake never ran: the comparisons below fail); falhou/ilegível → Fatalf: no answer is not "the session".
+		data, err := os.ReadFile(outFile)
+		if err != nil {
+			t.Fatalf("the fake bd recorded no assignee for %q: %v", command, err)
+		}
+		return string(data)
+	}
+
+	// Control: the claim the prompts used to spell out reproduces the incident, so the fake is not vacuous and the environment is
+	// the one the engine stamps.
+	if got := runClaim(t, "bd update ga-test1 --claim"); got != alias {
+		t.Fatalf("control: `bd update <id> --claim` recorded %q, want the alias %q (the environment does not reproduce the incident)", got, alias)
+	}
+
+	for _, p := range builtinWorkerPromptsForClaimTest(t) {
+		t.Run(p.name, func(t *testing.T) {
+			cmds := claimCommandsIn(p.text)
+			if len(cmds) == 0 {
+				t.Fatalf("no `bd update <id> --claim` command found")
+			}
+			for _, c := range cmds {
+				if got := runClaim(t, strings.ReplaceAll(c, "<id>", "ga-test1")); got != session {
+					t.Errorf("the prompt's claim command %q recorded %q as the assignee, want the session %q: Step 5 of the prompt (the assignee must be $GC_SESSION_NAME) would refuse it", c, got, session)
+				}
+			}
+		})
+	}
+}
