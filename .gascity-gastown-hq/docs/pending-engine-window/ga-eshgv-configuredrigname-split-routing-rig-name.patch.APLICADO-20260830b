+func ConfiguredRigName(cityPath string, a config.Agent, rigs []config.Rig) string {
+	if a.Dir == "" {
+		return ""
+	}
+	for _, rig := range rigs {
+		if a.Dir == rig.Name {
+			return rig.Name
+		}
+	}
+	abs := ResolveDirPath(cityPath, a.Dir)
+	for _, rig := range rigs {
+		if samePath(abs, rig.Path) {
+			return rig.Name
+		}
+	}
+	return ""
+}
