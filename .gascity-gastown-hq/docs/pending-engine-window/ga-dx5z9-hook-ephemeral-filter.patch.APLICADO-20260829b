+// TestEffectiveAssignedInProgressQueryPushesAssigneeFilterServerSide is the
+// regression test for ga-dx5z9. Before this fix, the Step-1a ephemeral-wisp
+// fallback asked bd for EVERY open/in_progress ephemeral wisp in the city
+// (`bd query --json 'ephemeral=true AND status=in_progress' --limit=0`, no
+// server-side filter) and matched the assignee afterward with jq. Measured
+// live: ~5.2s per call under normal load, 33s+ under high load (10-core
+// machine at load 31-36, dolt at 94.7% CPU) — a SINGLE call already exceeds
+// gc hook's fixed 30s deadline (hookWorkQueryTimeout, cmd/gc/cmd_hook.go),
+// and this tier runs that call once per non-empty id candidate on every gc
+// hook invocation. Per ga-dx5z9's own bead history this measurably caused a
+// city-wide dispatch-throughput collapse (timed-out hook -> ephemeral worker
+// drains empty -> bead stranded pilot:dispatched with no owner -> occupies a
+// dispatch-lane slot -> dispatch cap drops -> throughput falls).
+//
+// This test proves the SHAPE of the generated query changed — bd is now
+// ASKED for only the matching assignee, not asked for everything and
+// filtered afterward — two ways:
+//  1. A direct assertion that the generated command text contains the new
+//     "AND assignee=..." clause inside the bd query expression itself.
+//  2. An end-to-end run through a fake bd with TWO distinct exact-match case
+//     arms — one for the old (unfiltered) invocation text, one for the new
+//     (filtered) one — that each return a DIFFERENT, but equally
+//     jq-filter-survivable (matching assignee), bead. This isolates which
+//     literal query text the generated script actually sent to bd, so the
+//     result can't be explained away by the pre-existing client-side jq
+//     assignee check (kept as a redundant belt-and-suspenders layer) masking
+//     which shape was really used. Before ga-dx5z9's fix, this sub-check
+//     observes the OLD-shape bead and fails; after, it observes the
+//     NEW-shape bead and passes.
+func TestEffectiveAssignedInProgressQueryPushesAssigneeFilterServerSide(t *testing.T) {
+	a := Agent{Name: "worker", Dir: "hello-world"}
+	got := a.EffectiveAssignedInProgressQuery()
+
+	if !strings.Contains(got, `ephemeral=true AND status=in_progress AND assignee=\"$id\"`) {
+		t.Fatalf("EffectiveAssignedInProgressQuery() ephemeral fallback missing server-side assignee filter: %q", got)
+	}
+
+	out := runShellWithFakeBd(t, got, map[string]string{
+		"GC_SESSION_ID": "worker-bead",
+	}, `#!/bin/sh
+set -eu
+case "$*" in
+  "list --status in_progress --assignee=worker-bead --json --limit=20") printf '[]' ;;
+  "query --json ephemeral=true AND status=in_progress --limit=0") printf '[{"id":"ga-dx5z9-OLD-UNFILTERED-SHAPE","assignee":"worker-bead","ephemeral":true}]' ;;
+  'query --json ephemeral=true AND status=in_progress AND assignee="worker-bead" --limit=0') printf '[{"id":"ga-dx5z9-NEW-FILTERED-SHAPE","assignee":"worker-bead","ephemeral":true}]' ;;
+  *) printf '[]' ;;
+esac
+`)
+	if !strings.Contains(out, "ga-dx5z9-NEW-FILTERED-SHAPE") {
+		t.Fatalf("EffectiveAssignedInProgressQuery() output = %q, want the bead served only to the NEW server-side-filtered query text", out)
+	}
+	if strings.Contains(out, "ga-dx5z9-OLD-UNFILTERED-SHAPE") {
+		t.Fatalf("EffectiveAssignedInProgressQuery() output = %q, still sending the OLD unfiltered query text (downloads every ephemeral wisp in the city)", out)
+	}
+}
