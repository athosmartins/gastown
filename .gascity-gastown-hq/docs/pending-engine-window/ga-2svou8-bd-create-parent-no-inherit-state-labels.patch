diff --git a/third_party/beads/internal/types/label_inherit.go b/third_party/beads/internal/types/label_inherit.go
new file mode 100644
index 000000000..2f40ebabf
--- /dev/null
+++ b/third_party/beads/internal/types/label_inherit.go
@@ -0,0 +1,55 @@
+package types
+
+import "strings"
+
+// Labels a child never inherits from its parent.
+//
+// `bd create --parent` copies the parent's labels onto the new child. Most of
+// them are classification (lane:small, ctx:*) and are worth carrying down. The
+// families below are not: they record what an automation OBSERVED about one
+// specific bead — a gate verdict, a retry counter, a refusal reason, a
+// lifecycle flag. A child born with them reads as if it had already been
+// through that process and failed it, so a brand-new slice shows up parked or
+// escalated without ever having run.
+//
+// The match is on the label NAMESPACE (a literal prefix, case-sensitive), not
+// a substring: "gates:review", "mygate:x" and a bare "pilot" are unrelated
+// labels and keep being inherited.
+var nonInheritableLabelPrefixes = []string{
+	"gate:",            // gate verdicts and counters: gate:failed, gate:fix-attempt:N, gate:needs-human:*
+	"gate-sha-failed:", // per-SHA gate failure memo
+	"pilot:",           // pilot bookkeeping: reclaim/refusal counters, refused-reason
+	"lifecycle:",       // lifecycle flags such as lifecycle:label-conflict
+}
+
+// nonInheritableLabels are single labels (not a family) with the same problem.
+var nonInheritableLabels = map[string]struct{}{
+	"story:needs-human": {},
+}
+
+// IsInheritableLabel reports whether a label may be copied from a parent onto a
+// new child. It governs INHERITANCE only: a label the caller asks for by name
+// is never filtered, so `--labels gate:queued` still works.
+func IsInheritableLabel(label string) bool {
+	if _, blocked := nonInheritableLabels[label]; blocked {
+		return false
+	}
+	for _, prefix := range nonInheritableLabelPrefixes {
+		if strings.HasPrefix(label, prefix) {
+			return false
+		}
+	}
+	return true
+}
+
+// FilterInheritableLabels returns the labels that may be inherited, in their
+// original order. It never aliases the input; a nil result means none survive.
+func FilterInheritableLabels(labels []string) []string {
+	var kept []string
+	for _, label := range labels {
+		if IsInheritableLabel(label) {
+			kept = append(kept, label)
+		}
+	}
+	return kept
+}
diff --git a/third_party/beads/internal/types/label_inherit_test.go b/third_party/beads/internal/types/label_inherit_test.go
new file mode 100644
index 000000000..7bdf79ffe
--- /dev/null
+++ b/third_party/beads/internal/types/label_inherit_test.go
@@ -0,0 +1,61 @@
+package types
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestIsInheritableLabel(t *testing.T) {
+	cases := []struct {
+		label string
+		want  bool
+	}{
+		// State families: never inherited.
+		{"gate:failed", false},
+		{"gate:fix-attempt:2", false},
+		{"gate:needs-human:technical", false},
+		{"gate-sha-failed:48d62592411a65c77aca2ef29224faa651664593:code", false},
+		{"pilot:reclaim-count:escalated-at-3", false},
+		{"pilot:refused-reason:umbrella-sliced-owned-by-live-crew", false},
+		{"lifecycle:label-conflict", false},
+		{"story:needs-human", false},
+
+		// Classification and look-alikes: still inherited.
+		{"lane:small", true},
+		{"ctx:ready", true},
+		{"story:needs-refino", true},
+		{"story:unrefined", true},
+		{"gates:review", true},
+		{"mygate:failed", true},
+		{"Gate:failed", true},
+		{"gate", true},
+		{"pilot", true},
+		{"lifecycle", true},
+		{"waiting-on:external", true},
+		{"", true},
+	}
+	for _, tc := range cases {
+		if got := IsInheritableLabel(tc.label); got != tc.want {
+			t.Errorf("IsInheritableLabel(%q) = %v, want %v", tc.label, got, tc.want)
+		}
+	}
+}
+
+func TestFilterInheritableLabels(t *testing.T) {
+	in := []string{"lane:small", "gate:failed", "ctx:ready", "pilot:held", "story:needs-human"}
+	got := FilterInheritableLabels(in)
+	want := []string{"lane:small", "ctx:ready"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("FilterInheritableLabels = %v, want %v", got, want)
+	}
+	if !reflect.DeepEqual(in, []string{"lane:small", "gate:failed", "ctx:ready", "pilot:held", "story:needs-human"}) {
+		t.Fatalf("input was mutated: %v", in)
+	}
+
+	if got := FilterInheritableLabels([]string{"gate:failed"}); got != nil {
+		t.Fatalf("all-state input = %v, want nil", got)
+	}
+	if got := FilterInheritableLabels(nil); got != nil {
+		t.Fatalf("nil input = %v, want nil", got)
+	}
+}
