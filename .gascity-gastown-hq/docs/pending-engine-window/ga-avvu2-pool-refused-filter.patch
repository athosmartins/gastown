+	return `bd ready` + bdReadyIncludeEphemeralArg(includeEphemeralReady) + ` --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic` + bdReadyPoolDemandExcludeLabelArgs() + ` --json ` + limitFlag
