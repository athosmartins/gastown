+// TestEnsureRunning_DefersRestartWhenLivenessUncertain reproduces ga-ebbr2t
+// (AC1): when the provider reports that its liveness read is uncertain
+// (mirroring a tmux state-cache process-snapshot fetch failure), a
+// subsequent negative IsRunning must NOT be treated as confirmed death. The
+// reconciler must defer the stale-key retry to the next tick instead of
+// racing a fresh start against a session that is, in fact, still alive.
+func TestEnsureRunning_DefersRestartWhenLivenessUncertain(t *testing.T) {
+	defer SetStaleKeyDetectDelayForTest(0)()
+
+	store := beads.NewMemStore()
+	base := runtime.NewFake()
+	sp := &cacheBlindProvider{Fake: base, reportsCert: true}
+	mgr := NewManager(store, sp)
+
+	info, err := mgr.Create(context.Background(), "worker", "", "claude --dangerously", "/tmp", "claude", nil, ProviderResume{
+		ResumeFlag:    "--resume",
+		SessionIDFlag: "--session-id",
+	}, runtime.Config{})
+	if err != nil {
+		t.Fatalf("Create: %v", err)
+	}
+
+	b, err := store.Get(info.ID)
+	if err != nil {
+		t.Fatalf("Get bead: %v", err)
+	}
+	sessionKey := b.Metadata["session_key"]
+	if sessionKey == "" {
+		t.Fatal("expected session_key in bead metadata after Create with ResumeFlag")
+	}
+
+	if err := mgr.Suspend(info.ID); err != nil {
+		t.Fatalf("Suspend: %v", err)
+	}
+
+	// Arm the exact failure mode from the incident: the IsRunning check
+	// right after this session's own resume-Start will lie false, AND the
+	// provider reports that reading as uncertain (its state-cache fetch
+	// just failed) rather than confirmed.
+	sp.armed = true
+	sp.uncertain = true
+
+	resumeCmd := "claude --dangerously --resume " + sessionKey
+	if err := mgr.Send(context.Background(), info.ID, "hello", resumeCmd, runtime.Config{WorkDir: "/tmp"}); err != nil {
+		t.Fatalf("Send should defer to the next tick rather than fail when liveness is uncertain: %v", err)
+	}
+
+	if !base.IsRunning(info.SessionName) {
+		t.Fatal("the original, genuinely-live session must not be torn down")
+	}
+	if got := base.CountCalls("Start", info.SessionName); got != 2 {
+		t.Errorf("expected exactly 2 Start calls (Create + Send's wake, no fresh-start retry while liveness is uncertain), got %d", got)
+	}
+	if got := base.CountCalls("Stop", info.SessionName); got != 1 {
+		t.Errorf("expected exactly 1 Stop call (Suspend only, no destructive action from the uncertain liveness read), got %d", got)
+	}
+}
