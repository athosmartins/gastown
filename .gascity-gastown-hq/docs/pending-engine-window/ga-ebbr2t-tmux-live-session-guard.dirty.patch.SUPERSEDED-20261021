+// cacheBlindProvider simulates ga-ebbr2t: the tmux state cache's process
+// snapshot fetch fails right after a session starts, so IsRunning reports
+// false for a session that is genuinely still running (the cache's
+// last-known-good snapshot predates the session's creation, and the
+// refresh that would have picked it up just failed). Unlike
+// failOnceStartProvider/dieAndFailProvider, the session is NOT actually
+// stopped when IsRunning lies -- this is the "we can't currently observe
+// reality" case, not "the process died."
+//
+// The lie is deliberately keyed to "the next IsRunning call after this
+// session's own Start succeeds while armed" rather than a naive one-shot
+// flag: ensureRunning's incidental transportForBead IsRunning probe (called
+// before Start, at the top of the function) must keep reporting the real,
+// unarmed state, or a naive one-shot lie gets consumed there instead of at
+// the actual post-start stale-key check this test targets.
+type cacheBlindProvider struct {
+	*runtime.Fake
+	armed           bool // arms the lie; consumed on the IsRunning call after the next successful own-Start
+	startedSinceArm bool
+	uncertain       bool // LastObservationUncertain() mirrors a live cache-fetch failure
+	reportsCert     bool // whether this provider implements UncertainLivenessReporter at all
+}
+
+func (p *cacheBlindProvider) Start(ctx context.Context, name string, cfg runtime.Config) error {
+	err := p.Fake.Start(ctx, name, cfg)
+	if err == nil && p.armed {
+		p.startedSinceArm = true
+	}
+	return err
+}
+
+func (p *cacheBlindProvider) IsRunning(name string) bool {
+	if p.armed && p.startedSinceArm {
+		p.armed = false
+		p.startedSinceArm = false
+		return false
+	}
+	return p.Fake.IsRunning(name) //nolint:staticcheck // intentional: IsRunning is not on Fake, it's on Provider
+}
+
