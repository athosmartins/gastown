+// TestEffectiveWorkQueryRoutedTierExcludesStoryWithLiveMoleculeStep
+// (ga-i5bu7) is the end-to-end regression: the gc hook (EffectiveWorkQuery's
+// Tier 3, the routed-pool worker-claim path) must not hand a brand-new
+// worker a story bead whose mol-do-work molecule already has a live
+// in_progress step under a different, live worker. This is the exact shape
+// of the bug's own reproduction (wa-e30u5/wa-3hrgk/wa-1kszx, bead
+// description): the story is open+unassigned (so it clears every existing
+// label-based filter) but its molecule's step is already in progress
+// elsewhere. Fails on pre-fix code (would return the story), passes after.
+func TestEffectiveWorkQueryRoutedTierExcludesStoryWithLiveMoleculeStep(t *testing.T) {
+	a := Agent{Name: "worker", Dir: "hello-world"}
+	out := runEffectiveWorkQuery(t, a, map[string]string{
+		"GC_SESSION_ORIGIN": "ephemeral",
+	}, `#!/bin/sh
+set -eu
+case "$*" in
+  *"ready --metadata-field gc.routed_to=hello-world/worker --unassigned"*)
+    printf '[{"id":"story-with-live-step","metadata":{"molecule_id":"mol-1"}}]'
+    ;;
+  *"list --status in_progress --type step --json --limit 0"*)
+    printf '[{"id":"live-step","issue_type":"step","status":"in_progress","parent":"mol-1"}]'
+    ;;
+  *)
+    printf '[]'
+    ;;
+esac
+`)
+	if strings.Contains(out, "story-with-live-step") {
+		t.Fatalf("EffectiveWorkQuery() = %q, must not offer a story whose molecule has a live in_progress step (ga-i5bu7)", out)
+	}
+	if strings.TrimSpace(out) != "[]" {
+		t.Fatalf("EffectiveWorkQuery() = %q, want empty result once the only routed candidate is excluded", out)
+	}
+}
