+// TestPoolDemandExcludeLiveMoleculeStepJQ (ga-i5bu7) is the direct unit test
+// of the new jq filter, mirroring gastown.dog-1's original test matrix
+// (bead comment, 2026-08-29): a candidate with no molecule_id must survive
+// (the majority case — most beads are not mol-do-work roots), a candidate
+// whose molecule has no live step must survive, and a candidate whose
+// molecule DOES have a live in_progress step must be excluded.
+func TestPoolDemandExcludeLiveMoleculeStepJQ(t *testing.T) {
+	if _, err := exec.LookPath("jq"); err != nil {
+		t.Skip("jq not available; poolDemandExcludeLiveMoleculeStepJQ is a jq pipeline")
+	}
+
+	input := `[{"id":"live-molecule-story","metadata":{"molecule_id":"wa-avll0"}},{"id":"closed-molecule-story","metadata":{"molecule_id":"wa-closed1"}},{"id":"no-molecule-story"},{"id":"empty-molecule-story","metadata":{"molecule_id":""}}]`
+
+	shellCmd := `live_step_molecules='["wa-avll0"]'; printf '%s' '` + input + `' | ` + poolDemandExcludeLiveMoleculeStepJQ()
+	cmd := exec.Command("sh", "-c", shellCmd)
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("run poolDemandExcludeLiveMoleculeStepJQ: %v", err)
+	}
+
+	got := strings.TrimSpace(string(out))
+	if strings.Contains(got, `"live-molecule-story"`) {
+		t.Errorf("poolDemandExcludeLiveMoleculeStepJQ() output = %s, must not contain a story whose molecule has a live in_progress step", got)
+	}
+	for _, wantPresent := range []string{`"closed-molecule-story"`, `"no-molecule-story"`, `"empty-molecule-story"`} {
+		if !strings.Contains(got, wantPresent) {
+			t.Errorf("poolDemandExcludeLiveMoleculeStepJQ() output = %s, missing survivor %s (over-matched)", got, wantPresent)
+		}
+	}
+}
