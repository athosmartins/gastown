diff --git a/internal/beads/contract/portprobe.go b/internal/beads/contract/portprobe.go
new file mode 100644
index 000000000..40a2c48aa
--- /dev/null
+++ b/internal/beads/contract/portprobe.go
@@ -0,0 +1,78 @@
+package contract
+
+import (
+	"errors"
+	"net"
+	"strconv"
+	"syscall"
+	"time"
+)
+
+// PortProbe is the outcome of ProbePort. A dial has three answers, not two:
+// somebody accepted, nobody is listening, or the dial never finished. The last
+// one is what a saturated host produces (a full accept queue drops the SYN and
+// the kernel retransmits after 1s), and it must not be read as "nobody is
+// listening" — that reading is what made `bd` fall through to port 0 while
+// Dolt was alive and merely slow (ga-e5jbpl).
+type PortProbe int
+
+const (
+	// PortProbeReachable means a TCP connection was accepted.
+	PortProbeReachable PortProbe = iota
+	// PortProbeRefused means nothing is listening: the kernel refused the
+	// connection, or there was no port to dial.
+	PortProbeRefused
+	// PortProbeInconclusive means every attempt timed out or failed in a way
+	// that says nothing about whether a server is listening.
+	PortProbeInconclusive
+)
+
+// portProbeTimeouts is the dial budget of each attempt. The first attempt keeps
+// the historical 250ms so a healthy server costs exactly what it always cost;
+// the later ones only run after a dial that neither connected nor was refused.
+// 2s on the last attempt covers one kernel SYN retransmit (1s) with margin.
+var portProbeTimeouts = []time.Duration{250 * time.Millisecond, time.Second, 2 * time.Second}
+
+// portProbeBackoff is the pause between attempts.
+const portProbeBackoff = 50 * time.Millisecond
+
+// Seams for tests; production uses the net and time implementations.
+var (
+	portProbeDial  = net.DialTimeout
+	portProbeSleep = time.Sleep
+)
+
+// ProbePort dials host:port over TCP and classifies the result. Only a refused
+// connection is final; any other failure is retried with a longer budget and,
+// when the attempts run out, reported as PortProbeInconclusive — never as
+// PortProbeRefused.
+func ProbePort(host, port string) PortProbe {
+	// A port that is not a number in 1..65535 cannot be dialed at all, so there is nothing
+	// to wait for: it is "no port to dial", not a dial that failed.
+	if n, err := strconv.Atoi(port); err != nil || n < 1 || n > 65535 {
+		return PortProbeRefused
+	}
+	addr := net.JoinHostPort(host, port)
+	timeouts := portProbeTimeouts
+	if !DoltHostIsLocal(host) {
+		// No local PID can corroborate a miss on another host, and callers treat that miss as
+		// down, so waiting longer only delays the same verdict (and slows every call to a dead host).
+		timeouts = timeouts[:1]
+	}
+	for i, timeout := range timeouts {
+		if i > 0 {
+			portProbeSleep(portProbeBackoff)
+		}
+		// empty (ECONNREFUSED: nobody listens) → Refused, no retry;
+		// failed (timeout, EADDRNOTAVAIL, EMFILE, ...) → retry, then Inconclusive — never Refused
+		conn, err := portProbeDial("tcp", addr, timeout)
+		if err == nil {
+			_ = conn.Close()
+			return PortProbeReachable
+		}
+		if errors.Is(err, syscall.ECONNREFUSED) {
+			return PortProbeRefused
+		}
+	}
+	return PortProbeInconclusive
+}
diff --git a/internal/beads/contract/portprobe_test.go b/internal/beads/contract/portprobe_test.go
new file mode 100644
index 000000000..cfc6a43f6
--- /dev/null
+++ b/internal/beads/contract/portprobe_test.go
@@ -0,0 +1,167 @@
+package contract
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+)
+
+type probeDialCall struct {
+	addr    string
+	timeout time.Duration
+}
+
+// stubPortProbe replaces the probe's dial and sleep for one test. dial receives
+// the 0-based attempt number. It returns the calls seen and the sleeps taken.
+func stubPortProbe(t *testing.T, dial func(attempt int) (net.Conn, error)) (*[]probeDialCall, *[]time.Duration) {
+	t.Helper()
+	var calls []probeDialCall
+	var sleeps []time.Duration
+	origDial, origSleep := portProbeDial, portProbeSleep
+	portProbeDial = func(network, addr string, timeout time.Duration) (net.Conn, error) {
+		if network != "tcp" {
+			t.Errorf("dial network = %q, want tcp", network)
+		}
+		calls = append(calls, probeDialCall{addr: addr, timeout: timeout})
+		return dial(len(calls) - 1)
+	}
+	portProbeSleep = func(d time.Duration) { sleeps = append(sleeps, d) }
+	t.Cleanup(func() { portProbeDial, portProbeSleep = origDial, origSleep })
+	return &calls, &sleeps
+}
+
+func dialRefused() error {
+	return &net.OpError{Op: "dial", Net: "tcp", Err: os.NewSyscallError("connect", syscall.ECONNREFUSED)}
+}
+
+func dialTimedOut() error {
+	return &net.OpError{Op: "dial", Net: "tcp", Err: os.ErrDeadlineExceeded}
+}
+
+func TestProbePortRefusedIsFinalAndNotRetried(t *testing.T) {
+	calls, sleeps := stubPortProbe(t, func(int) (net.Conn, error) { return nil, dialRefused() })
+
+	if got := ProbePort("127.0.0.1", "3307"); got != PortProbeRefused {
+		t.Fatalf("ProbePort() = %v, want PortProbeRefused", got)
+	}
+	if len(*calls) != 1 || len(*sleeps) != 0 {
+		t.Fatalf("dials = %d, sleeps = %d; a refused connection is an answer and must not be retried", len(*calls), len(*sleeps))
+	}
+}
+
+func TestProbePortRetriesATimeoutUntilItConnects(t *testing.T) {
+	server, client := net.Pipe()
+	t.Cleanup(func() { _ = server.Close(); _ = client.Close() })
+	calls, sleeps := stubPortProbe(t, func(attempt int) (net.Conn, error) {
+		if attempt < 2 {
+			return nil, dialTimedOut()
+		}
+		return client, nil
+	})
+
+	if got := ProbePort("127.0.0.1", "3307"); got != PortProbeReachable {
+		t.Fatalf("ProbePort() = %v, want PortProbeReachable after two timeouts", got)
+	}
+	if len(*calls) != 3 {
+		t.Fatalf("dials = %d, want 3", len(*calls))
+	}
+	if len(*sleeps) != 2 {
+		t.Fatalf("sleeps = %d, want 2 (one between each pair of attempts)", len(*sleeps))
+	}
+}
+
+func TestProbePortExhaustedTimeoutsAreInconclusiveNeverRefused(t *testing.T) {
+	calls, _ := stubPortProbe(t, func(int) (net.Conn, error) { return nil, dialTimedOut() })
+
+	if got := ProbePort("127.0.0.1", "3307"); got != PortProbeInconclusive {
+		t.Fatalf("ProbePort() = %v, want PortProbeInconclusive: a dial that never finished is not 'nobody listens'", got)
+	}
+	var gotTimeouts []time.Duration
+	for _, c := range *calls {
+		if c.addr != "127.0.0.1:3307" {
+			t.Fatalf("dialed %q, want 127.0.0.1:3307", c.addr)
+		}
+		gotTimeouts = append(gotTimeouts, c.timeout)
+	}
+	if !reflect.DeepEqual(gotTimeouts, portProbeTimeouts) {
+		t.Fatalf("per-attempt timeouts = %v, want %v", gotTimeouts, portProbeTimeouts)
+	}
+	// The retries only help if the budget outlasts the kernel's 1s SYN retransmit.
+	if last := portProbeTimeouts[len(portProbeTimeouts)-1]; last <= time.Second {
+		t.Fatalf("last attempt budget = %v, must exceed the 1s SYN retransmit", last)
+	}
+}
+
+func TestProbePortOtherTransientErrorsAreInconclusiveToo(t *testing.T) {
+	// The exact failure bd reported in ga-e5jbpl is EADDRNOTAVAIL ("can't assign requested address").
+	stubPortProbe(t, func(int) (net.Conn, error) {
+		return nil, &net.OpError{Op: "dial", Net: "tcp", Err: os.NewSyscallError("connect", syscall.EADDRNOTAVAIL)}
+	})
+
+	if got := ProbePort("127.0.0.1", "3307"); got != PortProbeInconclusive {
+		t.Fatalf("ProbePort() = %v, want PortProbeInconclusive", got)
+	}
+}
+
+func TestProbePortOnAnotherHostIsProbedOnce(t *testing.T) {
+	calls, sleeps := stubPortProbe(t, func(int) (net.Conn, error) { return nil, dialTimedOut() })
+
+	if got := ProbePort("192.0.2.1", "3307"); got != PortProbeInconclusive {
+		t.Fatalf("ProbePort() = %v, want PortProbeInconclusive", got)
+	}
+	if len(*calls) != 1 || len(*sleeps) != 0 {
+		t.Fatalf("dials = %d, sleeps = %d; a non-local host keeps the single fast attempt", len(*calls), len(*sleeps))
+	}
+	if (*calls)[0].timeout != portProbeTimeouts[0] {
+		t.Fatalf("timeout = %v, want %v", (*calls)[0].timeout, portProbeTimeouts[0])
+	}
+}
+
+func TestProbePortRefusedAfterATimeoutIsFinal(t *testing.T) {
+	calls, _ := stubPortProbe(t, func(attempt int) (net.Conn, error) {
+		if attempt == 0 {
+			return nil, dialTimedOut()
+		}
+		return nil, dialRefused()
+	})
+
+	if got := ProbePort("127.0.0.1", "3307"); got != PortProbeRefused {
+		t.Fatalf("ProbePort() = %v, want PortProbeRefused", got)
+	}
+	if len(*calls) != 2 {
+		t.Fatalf("dials = %d, want 2 (timeout, then the refusal ends it)", len(*calls))
+	}
+}
+
+func TestProbePortWithoutADialablePortNeverDials(t *testing.T) {
+	calls, _ := stubPortProbe(t, func(int) (net.Conn, error) { return nil, dialTimedOut() })
+
+	for _, port := range []string{"", " ", "0", "-1", "abc", "65536", "3307 "} {
+		if got := ProbePort("127.0.0.1", port); got != PortProbeRefused {
+			t.Errorf("ProbePort(%q) = %v, want PortProbeRefused", port, got)
+		}
+	}
+	if len(*calls) != 0 {
+		t.Fatalf("dials = %d, want 0: there is nothing to dial", len(*calls))
+	}
+}
+
+func TestProbePortRealSockets(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := fmt.Sprintf("%d", listener.Addr().(*net.TCPAddr).Port)
+	if got := ProbePort("127.0.0.1", port); got != PortProbeReachable {
+		t.Fatalf("ProbePort(listening) = %v, want PortProbeReachable", got)
+	}
+
+	_ = listener.Close()
+	if got := ProbePort("127.0.0.1", port); got != PortProbeRefused {
+		t.Fatalf("ProbePort(closed) = %v, want PortProbeRefused", got)
+	}
+}
