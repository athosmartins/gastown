+func stubNudgePollSleep(t *testing.T) *[]time.Duration {
+	t.Helper()
+	var slept []time.Duration
+	prev := nudgePollSleep
+	nudgePollSleep = func(d time.Duration) { slept = append(slept, d) }
+	t.Cleanup(func() { nudgePollSleep = prev })
+	return &slept
+}
