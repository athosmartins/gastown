 }
+
+// ga-y5z6hzh: a slice created under a CLOSED, gated parent was born with the
+// parent's cycle state (gate:passed, story:done, ...) and the dispatcher skipped
+// it as already finished. The fixture is the label set such a parent held.
+func TestMergeCreateLabelsDoesNotInheritCycleLabels(t *testing.T) {
+	got := mergeCreateLabels(
+		[]string{"explicit-label"},
+		[]string{
+			"area:infra",
+			"gate:passed",
+			"gate:nonblocking-findings",
+			"gate-approved:0123456789abcdef0123456789abcdef01234567",
+			"gate-sha-failed:48d62592411a65c77aca2ef29224faa651664593:code",
+			"lane:small",
+			"story:done",
+			"story:gate",
+			"story:in-flight",
+			"story:epic-split",
+			"story:approved",
+			"exec:manual",
+			"exec:auto",
+			"pilot:no-auto-dispatch",
+			"pilot:reclaim-count:1",
+			"delivery:tested",
+			"next-action:mayor",
+		},
+	)
+	want := []string{"explicit-label", "area:infra", "lane:small", "story:approved", "exec:auto"}
+
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("merged labels = %v, want %v (only classification may be inherited)", got, want)
+	}
+}
+
+// The filter is about what is INHERITED. A label the caller asks for by name is
+// the caller's decision and must survive, state-looking or not.
+func TestMergeCreateLabelsKeepsExplicitCycleLabels(t *testing.T) {
+	got := mergeCreateLabels(
+		[]string{"gate:queued", "exec:manual"},
+		[]string{"gate:queued", "pilot:held", "lane:small"},
+	)
+	want := []string{"gate:queued", "exec:manual", "lane:small"}
+
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("merged labels = %v, want %v", got, want)
+	}
+}
+
+// A parent that carries nothing but state yields a child with no labels at all:
+// nil, as before, not an empty slice.
+func TestMergeCreateLabelsAllStateParentYieldsNil(t *testing.T) {
+	if got := mergeCreateLabels(nil, []string{"gate:passed", "story:done"}); got != nil {
+		t.Fatalf("merged labels = %v, want nil", got)
+	}
+}
