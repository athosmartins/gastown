new file mode 100644
index 0000000000..2c51138746
--- /dev/null
+++ b/cmd/gc/session_drift_interactive_crew.go
@@ -0,0 +1,114 @@
+package main
+
+import (
+	"strings"
+
+	"github.com/gastownhall/gascity/internal/beads"
+	"github.com/gastownhall/gascity/internal/config"
+	"github.com/gastownhall/gascity/internal/runtime"
+	sessionpkg "github.com/gastownhall/gascity/internal/session"
+	"github.com/gastownhall/gascity/internal/shellquote"
+)
+
+// remoteControlFlag is the Claude Code CLI flag that makes a session reachable
+// from the Claude app (Remote Control). The launch command takes it either as
+// `--remote-control [name]` (the name is the next argv token) or as
+// `--remote-control=<name>`.
+const remoteControlFlag = "--remote-control"
+
+// commandLaunchesRemoteControl reports whether a resolved launch command starts
+// the provider with Remote Control: one argv token is exactly --remote-control
+// or starts with --remote-control=. The command is split with the same
+// shell-like splitter the provider-option code uses, so a quoted argument that
+// merely mentions the flag (a prompt, a settings blob) is ONE token and does
+// not match.
+//
+// vazio → false (no token: not a Remote Control launch, the previous behavior);
+// ilegível → not applicable: shellquote.Split has no error path, an unclosed
+// quote is read literally and the worst case is a false negative, which keeps
+// the previous behavior. A false POSITIVE only withholds a drain, the inert
+// direction.
+func commandLaunchesRemoteControl(command string) bool {
+	for _, token := range shellquote.Split(command) {
+		if token == remoteControlFlag || strings.HasPrefix(token, remoteControlFlag+"=") {
+			return true
+		}
+	}
+	return false
+}
+
+// sessionInteractiveCrewForConfigDrift reports whether a live session is an
+// interactive crew member that a config drift must NEVER drain or restart: its
+// agent resumes its conversation across restarts (wake_mode is not "fresh"), the
+// session is past its creating window, it is not a gate-reviewer, and it was
+// launched with Remote Control (commandLaunchesRemoteControl on the CURRENT
+// resolved command). ga-fsm94q1.
+//
+// Why a static, probe-independent clause. A human reaches a Remote Control
+// session through the Claude app, which the engine cannot observe: Remote
+// Control is not a tmux client (IsAttached reads false), the session need not
+// be pinned, a conversation between two turns has no pending interaction, and a
+// crew need not be a configured named session. Every signal the drift paths
+// consult (attached, pinned, pending interaction, named-session activity, live
+// assigned work) can therefore read "idle" for a crew the human is in the middle
+// of a conversation with, and the drain closes the session out of the app.
+// Reported 24/11 13:41:43 (ga-fsm94q1): peter-wa drained ("session.draining:
+// config drift detected", then asleep/config-drift) while the Athos was working
+// with it through Remote Control. It is the same reasoning as
+// sessionIsAlwaysOnNamed: a clause that depends on no probe and no timing cannot
+// have a false negative.
+//
+// Scope, on purpose narrow: resume-wake crews launched with Remote Control only.
+// A fresh-wake pool worker (disposable, recycled on drift by design) and a
+// resume-wake session without Remote Control (a tmux attach is already honored
+// by sessionAttachedForConfigDrift) keep their existing behavior. Callers defer
+// the drift (reconciler: the stored hash stays stale and the drift stays
+// pending) or accept it in place (watch reload: the stored hash is rebaselined).
+// Either way the running process keeps its old config and the new one lands at
+// the session's next natural restart.
+func sessionInteractiveCrewForConfigDrift(
+	session beads.Bead,
+	cfg *config.City,
+	cfgAgent *config.Agent,
+	agentCfg runtime.Config,
+	stateBeforeHeal sessionpkg.State,
+) bool {
+	// vazio → agent not in the config (cfgAgent nil): not protected, as before (the
+	// drift check itself only runs for a configured agent); falhou → n/a, pure
+	// predicate over values already read by the caller
+	if cfgAgent == nil || cfgAgent.EffectiveWakeMode() != "resume" {
+		return false
+	}
+	if stateBeforeHeal == sessionpkg.StateCreating {
+		return false
+	}
+	if sessionIsGateReviewerTemplate(session, cfg) {
+		return false
+	}
+	return commandLaunchesRemoteControl(agentCfg.Command)
+}
+
+// sessionInteractiveCrewForDriftAcceptance is sessionInteractiveCrewForConfigDrift
+// for the watch-reload acceptance pass (acceptConfigDriftForProtectedSessions),
+// which runs before the reconciler and has none of its locals: it resolves the
+// agent and the pre-heal state from the session bead and the desired-state entry,
+// the same way the reconciler does.
+func sessionInteractiveCrewForDriftAcceptance(
+	session beads.Bead,
+	cfg *config.City,
+	tp TemplateParams,
+	agentCfg runtime.Config,
+) bool {
+	template := tp.TemplateName
+	if template == "" {
+		template = normalizedSessionTemplate(session, cfg)
+	}
+	// vazio → no template or agent not found: not protected, the session keeps the
+	// existing watch-reload handling; falhou → n/a, in-memory lookups
+	if template == "" {
+		return false
+	}
+	cfgAgent := findAgentByTemplate(cfg, template)
+	stateBeforeHeal := sessionpkg.State(strings.TrimSpace(session.Metadata["state"]))
+	return sessionInteractiveCrewForConfigDrift(session, cfg, cfgAgent, agentCfg, stateBeforeHeal)
+}
