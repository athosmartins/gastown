diff --git a/cmd/gc/session_reconciler_drift_interactive_crew_test.go b/cmd/gc/session_reconciler_drift_interactive_crew_test.go
new file mode 100644
index 0000000000..0c5943c385
--- /dev/null
+++ b/cmd/gc/session_reconciler_drift_interactive_crew_test.go
@@ -0,0 +1,260 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/gastownhall/gascity/internal/agent"
+	"github.com/gastownhall/gascity/internal/beads"
+	"github.com/gastownhall/gascity/internal/config"
+	"github.com/gastownhall/gascity/internal/runtime"
+)
+
+// ga-fsm94q1 — interactive crew (a resume-wake agent launched with Remote
+// Control) is never drained or restarted by config drift.
+//
+// Reported 24/11 13:41:43: a config-reload tick drained peter-wa while the
+// Athos was working with it through the Claude app ("session.draining: config
+// drift detected", then asleep/config-drift); the session left the app with no
+// warning. Remote Control is not a tmux client, the crew was not pinned, and
+// between two turns there is no pending interaction, so the attached/pinned/
+// pending/active guards all read "idle" and the ordinary-session branch of the
+// reconciler called beginSessionDrain.
+//
+// These tests drive the real reconcile loop (and the watch-reload acceptance
+// pass) against an in-memory store and a fake runtime, with the shape of that
+// session: alive, idle, unpinned, unattached, NOT a configured named session.
+// Every "spared" case has a sibling control that still drains, so a pass cannot
+// come from a session the reconciler never reached.
+//
+// On the unpatched base the "spared" cases FAIL by assertion (a drain is
+// begun / the drift is not accepted); the controls pass on both trees.
+
+const (
+	crewTemplate = "worker"
+	// rcCrewCommand is the shape of a named crew's resolved launch command
+	// (providers claude-rc-*: args_append = ["--remote-control", "<Name>", ...]).
+	rcCrewCommand = "claude --dangerously-skip-permissions --remote-control Peter --model opus"
+	// plainCrewCommand is the same crew WITHOUT Remote Control.
+	plainCrewCommand = "claude --dangerously-skip-permissions --model opus"
+)
+
+// setupCrewDrift wires an alive, idle, unpinned, unattached, non-named session
+// of `agentDef` whose live desired config is `tp` and whose stored start-time
+// fingerprint is mutate(current) — the config as it was BEFORE the drift. The
+// stored breakdown is written in the shape the start path uses, so the
+// reconciler observes real, field-level drift confined to what `mutate` changes.
+func setupCrewDrift(
+	t *testing.T,
+	agentDef config.Agent,
+	tp TemplateParams,
+	mutate func(current runtime.Config) runtime.Config,
+) (*reconcilerTestEnv, beads.Bead) {
+	t.Helper()
+	env := newReconcilerTestEnv()
+	env.cfg = &config.City{Agents: []config.Agent{agentDef}}
+	env.desiredState[tp.SessionName] = tp
+	_ = env.sp.Start(context.Background(), tp.SessionName, runtime.Config{Command: tp.Command})
+	session := env.createSessionBead(tp.SessionName, tp.TemplateName)
+	env.markSessionActive(&session)
+
+	currentCfg := sessionCoreConfigForHash(tp, session)
+	oldCfg := mutate(currentCfg)
+	started := runtime.CoreFingerprint(oldCfg)
+	if started == runtime.CoreFingerprint(currentCfg) {
+		t.Fatalf("test setup: stored (old) and live (current) core hashes must differ")
+	}
+	breakdownJSON, err := json.Marshal(runtime.CoreFingerprintBreakdown(oldCfg))
+	if err != nil {
+		t.Fatalf("marshaling stored breakdown: %v", err)
+	}
+	env.setSessionMetadata(&session, map[string]string{
+		"started_config_hash": started,
+		"core_hash_breakdown": string(breakdownJSON),
+	})
+	return env, session
+}
+
+func crewTemplateParams(command string, copyFiles ...runtime.CopyEntry) TemplateParams {
+	return TemplateParams{
+		Command:      command,
+		SessionName:  crewTemplate,
+		TemplateName: crewTemplate,
+		Hints:        agent.StartupHints{CopyFiles: copyFiles},
+	}
+}
+
+// commandDrift changes only the launch command: the drift is NOT scripts-only,
+// so the ga-epdbe3 scripts-only acceptance (if present in the stack) cannot be
+// what spares the session.
+func commandDrift(current runtime.Config) runtime.Config {
+	old := current
+	old.Command = "old-cmd"
+	return old
+}
+
+// TestRemoteControlCrewSparedFromConfigDriftDrain is the reported case: an
+// idle, unpinned, unattached crew launched with Remote Control, in drift on a
+// field other than the scripts copy. It must be neither drained nor stopped, and
+// the drift must stay PENDING (started_config_hash is not rewritten), so the new
+// config lands at the next natural restart instead of being silently dropped.
+func TestRemoteControlCrewSparedFromConfigDriftDrain(t *testing.T) {
+	env, session := setupCrewDrift(t, config.Agent{Name: crewTemplate}, crewTemplateParams(rcCrewCommand), commandDrift)
+	staleHash := storedConfigHash(t, env.store, session.ID)
+
+	env.reconcile([]beads.Bead{session})
+
+	if ds := env.dt.get(session.ID); ds != nil {
+		t.Fatalf("ga-fsm94q1: Remote Control crew must NOT be drained on config drift; got drain=%+v stderr=%s", ds, env.stderr.String())
+	}
+	if !env.sp.IsRunning(crewTemplate) {
+		t.Fatalf("ga-fsm94q1: Remote Control crew must keep running through config drift; stderr=%s", env.stderr.String())
+	}
+	if got := storedConfigHash(t, env.store, session.ID); got != staleHash {
+		t.Fatalf("ga-fsm94q1: the drift must stay pending (hash untouched); stored=%q want stale=%q", got, staleHash)
+	}
+}
+
+// TestRemoteControlCrewSparedFromScriptsOnlyConfigDriftDrain is the shape of a
+// commit under the city scripts/ tree: only the staged .gc/scripts copy changes
+// content. Whatever else guards that drift, the crew must not be drained.
+func TestRemoteControlCrewSparedFromScriptsOnlyConfigDriftDrain(t *testing.T) {
+	tp := crewTemplateParams(rcCrewCommand, settingsCopyEntry("settings-hash"), scriptsCopyEntry("scripts-hash-NEW"))
+	env, session := setupCrewDrift(t, config.Agent{Name: crewTemplate}, tp, func(current runtime.Config) runtime.Config {
+		old := current
+		old.CopyFiles = []runtime.CopyEntry{settingsCopyEntry("settings-hash"), scriptsCopyEntry("scripts-hash-OLD")}
+		return old
+	})
+
+	env.reconcile([]beads.Bead{session})
+
+	if ds := env.dt.get(session.ID); ds != nil {
+		t.Fatalf("ga-fsm94q1: Remote Control crew must NOT be drained for a scripts-only drift; got drain=%+v stderr=%s", ds, env.stderr.String())
+	}
+	if !env.sp.IsRunning(crewTemplate) {
+		t.Fatalf("ga-fsm94q1: Remote Control crew must keep running; stderr=%s", env.stderr.String())
+	}
+}
+
+// TestRemoteControlCrewConfigDriftDrainInFlightIsCanceled: a config-drift drain
+// already registered for the crew (a tick that did not know it was interactive)
+// is canceled instead of being left to escalate on the next tick.
+func TestRemoteControlCrewConfigDriftDrainInFlightIsCanceled(t *testing.T) {
+	env, session := setupCrewDrift(t, config.Agent{Name: crewTemplate}, crewTemplateParams(rcCrewCommand), commandDrift)
+	env.dt.set(session.ID, &drainState{
+		startedAt:  env.clk.Now(),
+		deadline:   env.clk.Now().Add(time.Minute),
+		reason:     "config-drift",
+		generation: 1,
+	})
+
+	env.reconcile([]beads.Bead{session})
+
+	if ds := env.dt.get(session.ID); ds != nil {
+		t.Fatalf("ga-fsm94q1: an in-flight config-drift drain of a Remote Control crew must be canceled; got drain=%+v stderr=%s", ds, env.stderr.String())
+	}
+}
+
+// TestResumeCrewWithoutRemoteControlStillDrainsOnConfigDrift is the control for
+// the three tests above: the SAME crew, the SAME drift, but launched without
+// Remote Control, still drains. The protection is the Remote Control launch, not
+// "every resume-wake session".
+func TestResumeCrewWithoutRemoteControlStillDrainsOnConfigDrift(t *testing.T) {
+	env, session := setupCrewDrift(t, config.Agent{Name: crewTemplate}, crewTemplateParams(plainCrewCommand), commandDrift)
+
+	env.reconcile([]beads.Bead{session})
+
+	ds := env.dt.get(session.ID)
+	if ds == nil {
+		t.Fatalf("control: a resume-wake session WITHOUT Remote Control must still drain on config drift; stderr=%s", env.stderr.String())
+	}
+	if ds.reason != "config-drift" {
+		t.Errorf("drain reason = %q, want config-drift", ds.reason)
+	}
+}
+
+// TestFreshWakeWorkerWithRemoteControlStillDrainsOnConfigDrift is the second
+// control: a fresh-wake (disposable pool) worker is recycled on drift by design,
+// even if its command happens to carry the flag.
+func TestFreshWakeWorkerWithRemoteControlStillDrainsOnConfigDrift(t *testing.T) {
+	env, session := setupCrewDrift(t, config.Agent{Name: crewTemplate, WakeMode: "fresh"}, crewTemplateParams(rcCrewCommand), commandDrift)
+
+	env.reconcile([]beads.Bead{session})
+
+	ds := env.dt.get(session.ID)
+	if ds == nil {
+		t.Fatalf("control: a fresh-wake worker must still drain on config drift; stderr=%s", env.stderr.String())
+	}
+	if ds.reason != "config-drift" {
+		t.Errorf("drain reason = %q, want config-drift", ds.reason)
+	}
+}
+
+// The watch-reload acceptance pass (acceptConfigDriftForProtectedSessions) is the
+// path the controller's own config-watch reload runs BEFORE the reconciler: it
+// accepts drift in place only for protected sessions, and every other drifted
+// session is left for the reconciler. A Remote Control crew is invisible to the
+// probes that pass uses, so it was left for the reconciler on every such reload.
+
+// TestRemoteControlCrewConfigDriftAcceptedInPlaceOnWatchReload: the crew's drift
+// is accepted in place (the hash is rebaselined off the stale one) and the
+// reconcile that follows sees no drift, so nothing is drained.
+func TestRemoteControlCrewConfigDriftAcceptedInPlaceOnWatchReload(t *testing.T) {
+	env, session := setupCrewDrift(t, config.Agent{Name: crewTemplate}, crewTemplateParams(rcCrewCommand), commandDrift)
+	staleHash := storedConfigHash(t, env.store, session.ID)
+
+	res := acceptConfigDriftForProtectedSessions(
