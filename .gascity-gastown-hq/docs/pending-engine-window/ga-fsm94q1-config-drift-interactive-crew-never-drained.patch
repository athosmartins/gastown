@@ -0,0 +1,124 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/gastownhall/gascity/internal/beads"
+	"github.com/gastownhall/gascity/internal/config"
+	"github.com/gastownhall/gascity/internal/runtime"
+	sessionpkg "github.com/gastownhall/gascity/internal/session"
+)
+
+// ga-fsm94q1 — unit tests of the interactive-crew predicate. The behavior of the
+// reconciler and of the watch-reload acceptance pass is covered by
+// session_reconciler_drift_interactive_crew_test.go.
+
+func TestCommandLaunchesRemoteControl(t *testing.T) {
+	cases := []struct {
+		name    string
+		command string
+		want    bool
+	}{
+		{"named, name as next token", "claude --dangerously-skip-permissions --remote-control Peter --model opus", true},
+		{"unnamed", "claude --remote-control", true},
+		{"unnamed, flag last after others", "claude --model opus --remote-control", true},
+		{"equals form", "claude --remote-control=Peter --model opus", true},
+		{"quoted name with a space", "claude --remote-control 'Batista PS' --model opus", true},
+		{"flag itself quoted", `claude "--remote-control" Peter`, true},
+		{"no flag", "claude --dangerously-skip-permissions --model opus", false},
+		{"empty command", "", false},
+		{"blank command", "   ", false},
+		{"longer flag with the same prefix", "claude --remote-controller", false},
+		{"negated flag", "claude --no-remote-control", false},
+		{"settings blob that mentions the setting", `claude --settings '{"remoteControlAtStartup":false}'`, false},
+		{"quoted prompt that mentions the flag", "claude --append-system-prompt 'start with --remote-control when asked'", false},
+		{"flag only inside a longer quoted token", `claude "x --remote-control y"`, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := commandLaunchesRemoteControl(tc.command); got != tc.want {
+				t.Fatalf("commandLaunchesRemoteControl(%q) = %v, want %v", tc.command, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestSessionInteractiveCrewForConfigDrift(t *testing.T) {
+	resumeAgent := &config.Agent{Name: "peter-wa"}
+	freshAgent := &config.Agent{Name: "wa-worker", WakeMode: "fresh"}
+	gateReviewerAgent := &config.Agent{Name: gateReviewerTemplateName}
+	rc := runtime.Config{Command: rcCrewCommand}
+	plain := runtime.Config{Command: plainCrewCommand}
+	sessionOf := func(template string) beads.Bead {
+		return beads.Bead{Metadata: map[string]string{"template": template}}
+	}
+	cfg := &config.City{Agents: []config.Agent{*resumeAgent, *freshAgent, *gateReviewerAgent}}
+
+	cases := []struct {
+		name     string
+		template string
+		agent    *config.Agent
+		agentCfg runtime.Config
+		state    sessionpkg.State
+		want     bool
+	}{
+		{"resume-wake crew with Remote Control, active", "peter-wa", resumeAgent, rc, sessionpkg.StateActive, true},
+		{"unknown state does not remove the protection", "peter-wa", resumeAgent, rc, sessionpkg.State(""), true},
+		{"still in the creating window keeps the old handling", "peter-wa", resumeAgent, rc, sessionpkg.StateCreating, false},
+		{"fresh-wake worker is recycled on drift by design", "wa-worker", freshAgent, rc, sessionpkg.StateActive, false},
+		{"resume-wake crew without Remote Control", "peter-wa", resumeAgent, plain, sessionpkg.StateActive, false},
+		{"agent not in the config", "peter-wa", nil, rc, sessionpkg.StateActive, false},
+		{"gate-reviewer template is never treated as a crew", gateReviewerTemplateName, gateReviewerAgent, rc, sessionpkg.StateActive, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := sessionInteractiveCrewForConfigDrift(sessionOf(tc.template), cfg, tc.agent, tc.agentCfg, tc.state)
+			if got != tc.want {
+				t.Fatalf("sessionInteractiveCrewForConfigDrift = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+// The acceptance-pass wrapper resolves the agent and the pre-heal state itself.
+func TestSessionInteractiveCrewForDriftAcceptance(t *testing.T) {
+	cfg := &config.City{Agents: []config.Agent{
+		{Name: "peter-wa"},
+		{Name: "wa-worker", WakeMode: "fresh"},
+	}}
+	rc := runtime.Config{Command: rcCrewCommand}
+	sessionWith := func(template, state string) beads.Bead {
+		return beads.Bead{Metadata: map[string]string{"template": template, "state": state}}
+	}
+
+	t.Run("template from the desired-state entry", func(t *testing.T) {
+		if !sessionInteractiveCrewForDriftAcceptance(sessionWith("", "active"), cfg, TemplateParams{TemplateName: "peter-wa"}, rc) {
+			t.Fatal("want true for a resume-wake Remote Control crew")
+		}
+	})
+	t.Run("template from the session bead when the entry has none", func(t *testing.T) {
+		if !sessionInteractiveCrewForDriftAcceptance(sessionWith("peter-wa", "active"), cfg, TemplateParams{}, rc) {
+			t.Fatal("want true: the template resolves from the session bead")
+		}
+	})
+	t.Run("no template anywhere", func(t *testing.T) {
+		if sessionInteractiveCrewForDriftAcceptance(sessionWith("", "active"), cfg, TemplateParams{}, rc) {
+			t.Fatal("want false: no template, so no agent to classify")
+		}
+	})
+	t.Run("agent not configured", func(t *testing.T) {
+		if sessionInteractiveCrewForDriftAcceptance(sessionWith("ghost", "active"), cfg, TemplateParams{TemplateName: "ghost"}, rc) {
+			t.Fatal("want false: agent missing from the config")
+		}
+	})
+	t.Run("creating state is not accepted", func(t *testing.T) {
+		if sessionInteractiveCrewForDriftAcceptance(sessionWith("peter-wa", "creating"), cfg, TemplateParams{TemplateName: "peter-wa"}, rc) {
+			t.Fatal("want false: a creating session keeps the existing handling")
+		}
+	})
+	t.Run("fresh-wake worker", func(t *testing.T) {
+		if sessionInteractiveCrewForDriftAcceptance(sessionWith("wa-worker", "active"), cfg, TemplateParams{TemplateName: "wa-worker"}, rc) {
+			t.Fatal("want false: fresh-wake workers are recycled on drift")
+		}
+	})
+}
