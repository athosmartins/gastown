+package main
+
+import (
+	"testing"
+	"time"
+
+	"github.com/gastownhall/gascity/internal/beads"
+	"github.com/gastownhall/gascity/internal/config"
+)
+
+// TestReconcileSessionBeads_AlwaysNamedPinnedLongLivedSessionRestartsWhenRuntimeVanishes
+// models ga-35cyh5: an operator closes the always-on, pinned Mayor terminal
+// after hours of uptime. The runtime disappears with no rapid-exit or churn
+// signature, and the controller must bring the session back on the following
+// tick without an explicit wake request.
+func TestReconcileSessionBeads_AlwaysNamedPinnedLongLivedSessionRestartsWhenRuntimeVanishes(t *testing.T) {
+	env := newReconcilerTestEnv()
+	env.cfg = &config.City{
+		Workspace:     config.Workspace{Name: "test-city"},
+		Agents:        []config.Agent{{Name: "worker", StartCommand: "true"}},
+		NamedSessions: []config.NamedSession{{Template: "worker", Mode: "always"}},
+	}
+	sessionName := config.NamedSessionRuntimeName(env.cfg.Workspace.Name, env.cfg.Workspace, "worker")
+	env.desiredState[sessionName] = TemplateParams{
+		Command:                 "true",
+		SessionName:             sessionName,
+		TemplateName:            "worker",
+		ConfiguredNamedIdentity: "worker",
+		ConfiguredNamedMode:     "always",
+	}
+	session := env.createSessionBead(sessionName, "worker")
+	wokeAt := env.clk.Now().Add(-3 * time.Hour).UTC().Format(time.RFC3339)
+	env.setSessionMetadata(&session, map[string]string{
+		namedSessionMetadataKey:      "true",
+		namedSessionIdentityMetadata: "worker",
+		namedSessionModeMetadata:     "always",
+		"pin_awake":                  "true",
+		"state":                      "active",
+		"last_woke_at":               wokeAt,
+		"session_key":                "old-key",
+		"started_config_hash":        "old-hash",
+	})
+
+	// The runtime is absent from the fake provider, exactly like a closed
+	// terminal. Give the controller a few patrol ticks; each is a normal
+	// 30s apart tick, well inside any backoff window.
+	for tick := 1; tick <= 3; tick++ {
+		current, err := env.store.Get(session.ID)
+		if err != nil {
+			t.Fatalf("tick %d: Get(%s): %v", tick, session.ID, err)
+		}
+		env.reconcile([]beads.Bead{current})
+		if env.sp.IsRunning(sessionName) {
+			return
+		}
+		env.clk.Time = env.clk.Time.Add(30 * time.Second)
+	}
+
+	final, _ := env.store.Get(session.ID)
+	t.Fatalf(
+		"always+pinned named session %q was not restarted within 3 ticks; state=%q sleep_reason=%q wake_attempts=%q quarantined_until=%q churn_count=%q",
+		sessionName,
+		final.Metadata["state"],
+		final.Metadata["sleep_reason"],
+		final.Metadata["wake_attempts"],
+		final.Metadata["quarantined_until"],
+		final.Metadata["churn_count"],
+	)
+}
