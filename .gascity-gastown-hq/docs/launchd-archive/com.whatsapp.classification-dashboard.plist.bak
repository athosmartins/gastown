<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LOG_SIGTERM_NTFY</key>
		<string>0</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.whatsapp.classification-dashboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/athos/gt/whatsapp_automation/launchd/classification-dashboard-wrapper.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>4096</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/Users/athos/gt/whatsapp_automation/logs/classification_dashboard_stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/athos/gt/whatsapp_automation/logs/classification_dashboard_stdout.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/athos/gt/whatsapp_automation</string>
</dict>
</plist>
