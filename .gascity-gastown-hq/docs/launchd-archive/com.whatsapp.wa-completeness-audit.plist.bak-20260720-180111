<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whatsapp.wa-completeness-audit</string>

    <!-- Camada A da auditoria de completude (wa-47xxh). READ-ONLY: lê campaigns.db,
         conversation_history.db e classifications.db e escreve 1 JSON por execução em
         logs/completeness/. NÃO manda alerta, NÃO toca aparelho, NÃO escreve em DB. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>

        <string>/Users/athos/gt/whatsapp_automation/scripts/wa_nightly_audit.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/athos/gt/whatsapp_automation</string>

    <!-- MEIA-NOITE (decisão do Athos): não é por frescura do dado — 00:00 e 05:00 leem o
         mesmo banco — é para a Camada B (on-device) ter os aparelhos OCIOSOS. A campanha
         começa a enviar às 7h, então 00:00 dá 7h de pista; 05:00 daria 2h. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/athos/gt/whatsapp_automation/logs/completeness_audit_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/athos/gt/whatsapp_automation/logs/completeness_audit_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
