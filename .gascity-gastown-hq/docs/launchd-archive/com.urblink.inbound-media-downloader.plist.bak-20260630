<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  inbound_media_downloader daemon (wa-dgxy) — download INBOUND on-device
  images/videos/documents (the direct twin of the voice-transcription gap).

  FLAG-GATED: the daemon is a no-op until chip_features `inbound_media_download`
  is enabled in /Users/athos/shared/config/chip_features.json, so loading this job
  is safe and changes nothing in production until Athos flips the switch.

  Install (when Athos is ready):
    cp daemons/launchd/com.urblink.inbound-media-downloader.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.urblink.inbound-media-downloader.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.urblink.inbound-media-downloader.plist
  Enable the feature:
    (edit chip_features.json: "inbound_media_download": {"enabled": true, ...})
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.urblink.inbound-media-downloader</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/athos/gt/whatsapp_automation/venv/bin/python</string>
		<string>/Users/athos/gt/whatsapp_automation/crew/oracle/daemons/inbound_media_downloader_daemon.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/inbound_media_downloader_err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/inbound_media_downloader.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/athos/gt/whatsapp_automation/crew/oracle</string>
</dict>
</plist>
