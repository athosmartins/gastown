<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whatsapp.contact-sync-sweep</string>
    <!-- wa-d9a0j (oracle, 01/08): WRITE side of the contact-sync readiness gate.
         The gate (chip_features.contact_sync_gate, armed 01/08 10:05) demotes a channel out
         of AUTH only on a FRESH 'STALLED' verdict; CONTACT_SYNC_FRESH_TTL is 5400s (90 min),
         so a verdict older than that stops counting and the protection silently lapses.
         Running every 45 min keeps every verdict comfortably inside the TTL.
         The sweep is sequential + paced and YIELDS to any device actively sending, so it
         never force-stops a chip mid-send. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/athos/gt/whatsapp_automation/venv/bin/python3</string>
        <string>/Users/athos/gt/whatsapp_automation/scripts/contact_sync_probe_sweep.py</string>
        <string>--live</string>
        <string>--pace-s</string>
        <string>6</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/athos/gt/whatsapp_automation</string>
    <key>StartInterval</key>
    <integer>2700</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/contact_sync_sweep.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/contact_sync_sweep.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONPATH</key>
        <string>/Users/athos/gt/whatsapp_automation:/Users/athos/gt/whatsapp_automation/lib</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
