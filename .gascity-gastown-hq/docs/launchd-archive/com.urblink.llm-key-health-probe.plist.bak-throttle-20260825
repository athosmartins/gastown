<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.urblink.llm-key-health-probe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/athos/gt/whatsapp_automation/launchd/llm-key-health-probe-wrapper.sh</string>
    </array>

    <!-- Hourly LLM key health canary (wa-xu8cj). -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/athos/gt/whatsapp_automation/logs/llm_key_health_probe.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/athos/gt/whatsapp_automation/logs/llm_key_health_probe.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/athos/gt/whatsapp_automation</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/athos/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/athos</string>
    </dict>
</dict>
</plist>
