<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- ga-zgqssr7. StartInterval 1800 (era 7200): sob pressao de disco (livre < PRESSURE_FREE_GB) toda batida e uma passada; sem pressao o proprio script sai na hora se a ultima
       passada comecou ha menos de WORKTREE_REAPER_NORMAL_INTERVAL_S (6900 s), entao o ritmo normal continua ~7200 s. Uma passada dura mediana ~5 min, maxima medida ~27 min (< 1800 s);
       se passar disso o evento pass_exceeds_interval aparece no jsonl e o lock (worktree-reaper.lock.d) impede duas passadas ao mesmo tempo.
       A entrega NAO aplica este arquivo: depois do merge, copiar para ~/Library/LaunchAgents/ e `launchctl unload` + `launchctl load` (ou bootout/bootstrap). -->
  <key>Label</key><string>com.gascity.worktree-reaper</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/worktree-reaper.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>1800</integer>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/worktree-reaper.err</string>
  <key>EnvironmentVariables</key><dict>
    <key>BD_ACTOR</key><string>automation</string>
    <key>PATH</key><string>/Users/athos/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
