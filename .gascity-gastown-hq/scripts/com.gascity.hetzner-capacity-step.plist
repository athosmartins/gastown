<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- ga-2hd02v.2. 180 s: o relógio das leituras de capacidade do nó. A escada de degraus não pode depender de o Pilot pedir veredito (a varredura leva 25-40 min, ~2 leituras
       por janela: o degrau nunca subia). `step` mede se a última leitura passou de refresh_s (60 s), avalia a escada e grava; não dá veredito nem abre/fecha sessão.
       180 s = 3 leituras na janela de 480 s; um ciclo perdido ainda deixa a leitura dentro do max_age_s (900 s). Instalar, conferir e retirar: docs/runbooks/hetzner-capacity.md. -->
  <key>Label</key><string>com.gascity.hetzner-capacity-step</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/hetzner-capacity.py</string>
    <string>step</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/athos/gt/.gascity-gastown-hq</string>
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/hetzner-capacity-step.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/hetzner-capacity-step.err</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key><string>/Users/athos</string>
    <key>GC_CITY_PATH</key><string>/Users/athos/gt/.gascity-gastown-hq</string>
  </dict>
</dict></plist>
