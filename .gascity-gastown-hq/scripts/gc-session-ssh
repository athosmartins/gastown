#!/usr/bin/env -S python3 -I
"""gc-session-ssh — provider de sessões do Gas City (protocolo `exec:`) que abre as sessões num host remoto por ssh, com a mesma
interface das locais (start, stop, interrupt, is-running, peek, nudge, send-keys, list-running, process-alive, get-last-activity,
meta, attach). ga-2hd02v.1.1, desenho do ga-ukxa3k, fatia 2. Python 3.9+, só biblioteca padrão.

Contents
  Uso · O que faz · Vários hosts e o MBP · O que NÃO faz · Configuração · Códigos de saída

USO
  GC_SESSION=exec:<cidade>/scripts/gc-session-ssh                (ou, no híbrido, `remote_exec` — patch em docs/pending-engine-window/)
  gc-session-ssh <op> <sessão> [args]        o engine chama assim, com o JSON do start na entrada padrão
  gc-session-ssh --dry-run start <sessão> < start.json     (ou GC_SSH_DRYRUN=1) imprime o que rodaria no host e NÃO conecta
                                                           (`would_refuse`: a recusa LOCAL de política — sessão real sem liberação… — que o start de verdade daria; null = nenhuma recusa
                                                           local, NÃO "o start vai ser aceito": o sha e o --selfcheck do guarda só rodam no host, no start de verdade)
  gc-session-ssh gate <host>      (não é do protocolo do engine) o veredito de um start AGORA nesse host, sem abrir nada: JSON, exit 0/1

O QUE FAZ
  Cada operação é UM ssh (ControlMaster em ~/.ssh/cm, o mesmo do mbp-run.sh) que leva um script sh pela entrada padrão; o
  script usa um tmux em socket próprio (`tmux -L <socket>`), então só as sessões deste provider existem lá. A saída vem entre
  marcadores: ruído de .bashrc não vira dado e resposta cortada é erro, não "lista vazia".
  start: confere o teto do host (`cap`) e a existência NO MESMO script que abre a sessão, sob flock no mini; reescreve os caminhos do
  mini para os do host com as MESMAS regras do remote-bundle-build.py (cidade → <remote_root>/city, ~/gt → <remote_root>/work, home →
  remote_home, e <cidade>/.gc/settings.json → <remote_root>/city/settings.json, onde o bundle o instala); passa o comando como veio
  (--settings, --dangerously-skip-permissions, --model, --remote-control...; o lançador de pool do mini, claude-ctxcap-ab.sh ou claude-lowprio.sh,
  que não existe no host, vira `claude`) mais o prompt de partida (prompt_suffix/prompt_flag do
  JSON do start — campos que o patch do engine acrescenta); grava tudo num lançador temporário que se apaga ao rodar.
  PREPARO DO WORKTREE (ga-2hd02v.1.5.9, decisão do Mayor 17/10): no MESMO script, depois do teto e da existência e antes de criar qualquer coisa, o start grava no host
  (1) a identidade git POR WORKTREE (`git config --worktree user.name <sessão>` e `user.email <sessão>@gastown.invalid`; num espelho BARE liga extensions.worktreeConfig e move o
  core.bare para o config.worktree, senão o commit dos worktrees quebra; lê de volta e confere que a identidade que o git LÊ é a da sessão) e (2) a confiança da pasta em
  {remote_home}/.claude.json (hasTrustDialogAccepted + hasCompletedProjectOnboarding do work_dir, troca atômica, modo mantido, lido de volta; arquivo ausente ou ilegível = nada é gravado).
  A pasta tem que EXISTIR e ser um worktree git (o start não a cria: quem cria é o wt-add — chamado pelo PRÓPRIO provider nos papéis de `worktree_rigs`, parágrafo seguinte). Qualquer falha = exit 13 do script, start falha dizendo o motivo, nada abre e nenhum lançador
  fica — a sessão nunca abre "meio pronta". Liga por padrão; o notebook do Athos (presence_gate) tem a identidade e a confiança DELE e fica de fora (padrão desligado).
  WORKTREE DO PROVIDER (ga-2hd02v.1.7, decisão do Mayor 18/10): sessão `<papel>-remote-…` com o papel em `worktree_rigs` (papel → rig) abre num worktree que o PRÓPRIO start cria, `<remote_home>/gt-remote/git/<rig>/wt/<sessão>`
  (o work_dir do template é ignorado): depois do teto e da existência roda o `hetzner-remote-git.sh wt-add` e SÓ ENTÃO o guarda de clone (que olha o checkout) e o preparo; start que falha depois do wt-add recolhe o que criou.
  O stop derruba a sessão e recolhe o worktree (wt-rm) SÓ se estiver limpo e com todo commit já no origin/main do espelho ou na ref da sessão; qualquer dúvida mantém, e o resultado (removed | kept <motivo> | none)
  vai para o evento `stopped` e o log — nunca para o rc do stop. Sem `worktree_rigs` nada disto existe. O nome da sessão vira o do worktree e do branch worker/<nome> (minúsculas). Nomes que o ENGINE gera
  (`<modelo>-<cauda da bead>`, `<modelo>-adhoc-<10>`) não são pedido de host. Falha de ssh = erro visível (stderr, exit 1, linha em <estado>/session-ssh.log) e nada pela metade; o mini não é tocado.
  "Não sei" nunca vira resposta: se o ssh responde mas o tmux do host não consegue olhar (ex.: socket sem permissão), as operações sobre
  sessões (todas, menos attach, que entrega o terminal ao tmux do host) saem com erro e o motivo — nunca `false`, lista vazia ou "há vaga". Sessão que não existe (tmux respondeu) segue o contrato do exec: stop,
  interrupt, nudge, send-keys, clear-scrollback e get-last-activity saem 0 sem fazer nada; `stop` só sai 0 se a sessão sumiu.

VÁRIOS HOSTS E O MBP (ga-w7qwl1)  O host de uma sessão vem de $GC_SSH_HOST, senão do que o NOME pede (`<papel>-remote-<host>-…`, o mesmo
  `-remote-` do remote_match do híbrido), senão de default_host; nome que pede host fora da config recusa. list-running junta TODOS os hosts
  (ou só o de $GC_SSH_HOST); host que não responde é erro — salvo um host `sleeps` (notebook) sem nenhuma sessão nossa registrada em
  <estado>/<host>/running/, que só sai da lista ("não responde" = ssh 255 ou tempo esgotado; resposta truncada ou tmux ilegível seguem
  erro). O registro nasce ANTES do ssh do start (start ambíguo fica registrado) e só uma recusa clara do host o apaga. Host com `presence_gate` (o MBP, notebook de trabalho do Athos): a CADA start roda
  `gate_cmd` (padrão: scripts/mbp-run.sh --check, a mesma regra do mbp-offload) e só abre com evidência POSITIVA de "Athos fora e MBP
  saudável" — em uso, pausa, bandeira desligada, sem saúde, resposta ilegível ou que não roda: recusa, sem ssh. O teto efetivo é o menor
  entre `cap` e o slot_cap da checagem (RAM). A sessão nasce em nice 10 com um vigia ao lado (biblioteca de presença do host, instalada por
  `mbp-offload.sh install-mbp`): se o Athos voltar ou pausar, a árvore da sessão cai para prioridade de fundo e não volta a subir; a
  sessão em curso NÃO é morta. Sem a biblioteca no host o start recusa. Cada start/recusa/stop vira uma linha em <estado>/<host>/events.jsonl
  (insumo do placar: scripts/session-host-scoreboard.py).

O QUE NÃO FAZ (cada item é de outra fatia ou é recusa de propósito)
  pre_start, session_setup*, session_live, overlay/pack_overlay_dirs, copy_files, copy-to: NÃO executam nem copiam (seriam comandos e
  arquivos do mini no servidor; as fatias .1.2/.1.3 decidem) — ficam registrados como "ignored". `nudge` do start também não é
  entregue (o provider exec do engine tampouco; quem entrega é o Nudge depois do start). Env: só GC_*, TERM, LANG, LC_*, TZ, e o que
  parece segredo (TOKEN, SECRET, PASSWORD, KEY...) não vai, a menos que o nome esteja em `env_allow` da config. check-image,
  watch-startup, run-live e qualquer operação desconhecida: exit 2 ("não suportado"), sem tocar em sessão nenhuma.
  Meta (set/get/remove-meta) fica no MINI (<estado>/meta): nada disso vai para o servidor.
  SESSÃO REAL NÃO ABRE sem a liberação e sem o guarda de clone (ga-2hd02v.1.5, decisão Q4 do Mayor): só abre o que se chama
  remote-e2e-<x> ou remote-test-<x> (a sessão mínima de teste). Qualquer outro nome exige (1) `real_sessions_released_by` na config do host
  — decisão EXPLÍCITA do Mayor; ausente, vazio ou não-texto = recusa, sem ssh — e (2) conferir NO host, dentro do mesmo script do start,
  que {remote_home}/.claude/hooks/remote-clone-guard.py é byte a byte o do repositório e que o `--selfcheck` dele aprova as settings
  do host e a pasta da sessão (hook em Bash/Edit/Write/MultiEdit/NotebookEdit, com `|| exit 2`, sem disableAllHooks em nenhuma camada); senão exit 12 do script e nada abre.

CONFIGURAÇÃO  $GC_SSH_CONFIG ou <cidade>/.gc/session-ssh.json (cidade = pasta acima de scripts/)
  {"default_host": "hetzner", "hosts": {"hetzner": {"ssh": "hetzner-teste", "cap": 4,
     "remote_root": "/home/runner/gt-remote/bundle", "remote_home": "/home/runner"}}}
  obrigatórios: ssh (alias/destino), cap (teto de sessões deste host, contado SÓ no socket do provider, separado do teto do mini),
  remote_root (= --remote-root do remote-bundle-build.py), remote_home. opcionais: socket (gc-remote), connect_timeout (10),
  timeout (25) e start_timeout (60) em segundos, ssh_opts [], env_allow [], mini_home, real_sessions_released_by (ver acima), worktree_prepare (true/false; padrão true, e false num host
  com presence_gate: preparo do worktree no start, ver acima; texto no lugar de true/false é erro de configuração), worktree_rigs ({"dog": "gascity"}: papel → rig dos worktrees que o provider cria e recolhe; ausente = nenhum). Só para o notebook (MBP): path_extra [] (dirs
  absolutos à frente do PATH do ssh sem login: /opt/homebrew/bin), presence_gate (true), gate_cmd ([lista]), presence_lib (padrão
  <remote_home>/gt-remote/bin/mbp-presence.sh), watch_s (5), sleeps (true). Estado no mini:
  $GC_EXEC_STATE_DIR ou <cidade>/.gc/runtime/session-ssh, sempre em <estado>/<host>/. Não há padrão para o cap: sem ele não abre sessão.

CÓDIGOS  0 ok · 1 erro (mensagem em stderr; "already exists" no start vira ErrSessionExists no engine) · 2 operação não suportada
  (dentro do script do host, que o provider traduz em exit 1 com a mensagem: 10 teto, 11 já existe, 12 recusa de política no host: sessão real sem guarda de clone verificado, ou host de presença sem a biblioteca,
  13 o worktree da sessão não ficou pronto: wt-add que falhou, pasta que não é worktree git, identidade git ou confiança da pasta que não foi gravada)
"""
from __future__ import annotations

import base64
import fcntl
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone

NAME_RE = re.compile(r"[A-Za-z0-9_-]+")  # o mesmo conjunto que o tmux local aceita (validSessionNameRe do engine): vai para shell
KEY_RE = re.compile(r"[A-Za-z0-9_.-]+")
PATH_RE = re.compile(r"/[A-Za-z0-9_./+-]+")  # caminho remoto da config: absoluto, sem espaço nem aspas (entra em script de shell)
HOST_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.@:-]*")
ENV_KEY = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
ENV_OK = re.compile(r"GC_[A-Z0-9_]+|TERM|LANG|LC_[A-Z_]+|TZ")
SECRETISH = re.compile(r"TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|API_?KEY|PRIVATE", re.I)
IGNORED = ("pre_start", "session_setup", "session_setup_script", "session_live", "pack_overlay_dirs", "overlay_dir", "copy_files", "nudge")
BEGIN, END = "@@GC-BEGIN@@", "@@GC-END@@"
EX_CAP, EX_EXISTS, EX_POLICY, EX_PREP = 10, 11, 12, 13
TEST_RE = re.compile(r"remote-(?:e2e|test)-[A-Za-z0-9_-]+")  # a sessão MÍNIMA de teste: a única que abre sem a liberação e sem o guarda de clone
GUARD = "remote-clone-guard.py"
# Lançadores de pool do MINI: claude-lowprio.sh baixa a prioridade (renice) e carrega o A/B de --effort; claude-ctxcap-ab.sh carrega o A/B de --autocompact
# (os dois A/B são inertes sem o .conf na cidade); ambos dão exec no claude. O bundle não leva <cidade>/packs, então o caminho reescrito apontaria para
# um arquivo que NÃO existe no host e o lançador derrubaria a sessão com "comando não encontrado" (ga-2hd02v.1.5.3, ponto em aberto 1): no host o
# comando começa direto no `claude`, e a sessão remota fica FORA desses dois A/B (e do claude-lowprio.log).
POOL_WRAPPER = "/packs/town-deltas/assets/scripts/claude-(?:ctxcap-ab|lowprio)\\.sh"
# Preparo da pasta da sessão NO START (ga-2hd02v.1.5.9, decisão do Mayor 17/10): o servidor não tem identidade git e o claude não pré-confia a pasta (o diálogo
# "confiar nesta pasta" seguraria a sessão), então o start grava as DUAS coisas por worktree e, se qualquer uma falhar, o start falha — a sessão nunca abre "meio pronta".
# O código nasceu no PREPARE do hetzner-proof.py e2e (medido 17/10, 3 sessões reais sem diálogo); aquele passo agora só cria o worktree e deixa o resto para o start.
# Roda dentro do mesmo script do start, depois do teto e da existência e ANTES de criar qualquer coisa. @NAME@ = a sessão (= autor dos commits), @WORKDIR@ = a pasta,
# @TRUSTFILE@ = o ~/.claude.json do host. sh puro (dash): o ssh roda `sh`, não bash.
PREPARE_SH = r"""W=@WORKDIR@; N=@NAME@; TF=@TRUSTFILE@
pfail() { echo "preparo da sessão $N recusado: $1" >&2; exit @EXPREP@; }
command -v git >/dev/null 2>&1 || pfail "git não está instalado no host"
command -v python3 >/dev/null 2>&1 || pfail "python3 não está instalado no host"
[ -d "$W" ] || pfail "$W não existe: a pasta da sessão tem que ser um worktree git já criado (wt-add)"
# vazio (não diz "true") → recusa "não é um worktree git"; falhou (git ausente do repositório, pasta ilegível) → a mesma recusa: nenhum dos dois abre a sessão
[ "$(git -C "$W" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] || pfail "$W não é um worktree git"
C=$(cd "$W" && cd "$(git rev-parse --git-common-dir)" && pwd -P) || pfail "não achei o repositório de $W"
# vazio (rc 1, chave ausente) → liga a extensão; falhou (rc > 1: config ilegível) → recusa, nunca "ausente"
x=$(git -C "$C" config --get extensions.worktreeConfig); rc=$?; [ "$rc" -le 1 ] || pfail "não consegui ler extensions.worktreeConfig de $C"
if [ "$x" != true ]; then  # ligado à mão num repo BARE, o core.bare compartilhado quebra o commit em todo worktree: ele vai para o config.worktree do principal
  git -C "$C" config extensions.worktreeConfig true || pfail "não consegui ligar extensions.worktreeConfig em $C"
  # vazio (rc 1, sem core.bare) → repositório comum, nada a mover; falhou (rc > 1) → recusa; true → move
  b=$(git -C "$C" config --bool --get core.bare); rc=$?; [ "$rc" -le 1 ] || pfail "não consegui ler core.bare de $C"
  if [ "$b" = true ]; then
    { git -C "$C" config --worktree core.bare true && git -C "$C" config --unset core.bare; } || pfail "não consegui mover core.bare para o config.worktree de $C"
  fi
fi
git -C "$W" config --worktree user.name "$N" && git -C "$W" config --worktree user.email "$N@gastown.invalid" || pfail "não consegui gravar a identidade git em $W"
# vazio ou falhou (não lê nome/e-mail) → o teste de igualdade falha e a recusa sai; só a identidade EXATA da sessão passa
[ "$(git -C "$W" config --get user.name)" = "$N" ] && [ "$(git -C "$W" config --get user.email)" = "$N@gastown.invalid" ] || pfail "a identidade git não ficou valendo em $W (outra camada de config a sobrepõe?)"
python3 -I - "$TF" "$W" <<'PY' || pfail "não consegui gravar a confiança da pasta em $TF (ver a mensagem acima)"
import json, os, sys, tempfile
p, w = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(p))  # vazio ({}) → entra só o projeto da sessão; ausente/ilegível/forma estranha → o erro cai no except: nada é gravado, o start falha, nunca um arquivo novo no lugar do login do claude
    pr = d.setdefault("projects", {}).setdefault(w, {})
    pr.update(hasTrustDialogAccepted=True, hasCompletedProjectOnboarding=True)
    pr.setdefault("allowedTools", [])
    fd, t = tempfile.mkstemp(dir=os.path.dirname(p))
    with os.fdopen(fd, "w") as f:
        json.dump(d, f)
    os.chmod(t, os.stat(p).st_mode & 0o777)
    os.replace(t, p)
    back = json.load(open(p))["projects"][w]  # lê de volta: o claude também regrava este arquivo, e gravação perdida não pode passar por feita
    assert back["hasTrustDialogAccepted"] is True and back["hasCompletedProjectOnboarding"] is True
except Exception as e:
    print(f"{p}: {type(e).__name__}: {e}", file=sys.stderr)
    sys.exit(1)
PY
"""
# Worktree DA SESSÃO, criado e recolhido pelo provider (ga-2hd02v.1.7, decisão do Mayor 18/10): para o papel que a config mapeia em `worktree_rigs`, o start roda o `wt-add` do
# hetzner-remote-git.sh e o stop o `wt-rm`. Os dois formatos abaixo são OS DO SCRIPT (RE_RIG, RE_BEAD); o selftest confere o texto dele.
RIG_RE = re.compile(r"[a-z][a-z0-9_-]{0,40}")
WT_NAME_RE = re.compile(r"[a-z0-9][a-z0-9._-]{0,60}")  # o nome da sessão vira o nome do worktree e o do branch worker/<nome>
ROLE_RE = re.compile(r"[a-z][a-z0-9-]*")
WT_START_FLOOR = 150  # o wt-add puxa o espelho antes de criar o worktree: os 60 s padrão do start não bastam (o engine espera 180 s, [session] startup_timeout)
# Recolhe o worktree da sessão SÓ se nada se perde (limpo, e todo commit já está no main do origin ou na ref da sessão no espelho). Imprime `WT removed`, `WT kept <motivo>` ou `WT none`
# e NUNCA devolve erro: o stop não falha por causa dele, e o start que falhou depois do wt-add o usa no EXIT. Dúvida (git ilegível, ref ausente) = MANTÉM.
# Os nomes de variável levam o prefixo w para não pisar nas do PRELUDE (o sh não tem escopo de função). @WT@ pasta, @REPO@ repo.git, @BRREF@ refs/heads/worker/<n>, @BRNAME@ worker/<n>.
WTCLEAN_SH = r"""wtclean() {
  [ -e @WT@ ] || { echo "WT none"; return 0; }
  # vazio → nada a perder; falhou (o git não lê o worktree) → MANTÉM: "não consegui saber" nunca vira "limpo"
  wst=$(git -C @WT@ status --porcelain 2>&1) || { echo "WT kept o git não leu o worktree"; return 0; }
  [ -z "$wst" ] || { echo "WT kept há alteração não commitada"; return 0; }
  # HEAD ilegível → MANTÉM; branch da sessão ausente (rc 1) → só o HEAD conta; ilegível (rc > 1) → MANTÉM
  wh=$(git -C @WT@ rev-parse HEAD 2>/dev/null) || { echo "WT kept não li o HEAD"; return 0; }
  wb=$(git -C @REPO@ rev-parse -q --verify @BRREF@ 2>/dev/null); wrc=$?
  [ "$wrc" -le 1 ] || { echo "WT kept não li o branch da sessão"; return 0; }
  for wc in "$wh" "$wb"; do
    [ -n "$wc" ] || continue
    # no main do origin (0) = publicado; fora dele (1) → só se o espelho tem o MESMO commit na ref da sessão; qualquer outro código (ref ausente, repositório ilegível) → MANTÉM
    git -C @REPO@ merge-base --is-ancestor "$wc" refs/remotes/origin/main 2>/dev/null; wr=$?
    if [ "$wr" -ne 0 ]; then
      [ "$wr" -eq 1 ] || { echo "WT kept não consegui conferir a publicação"; return 0; }
      wpub=0
      for wref in refs/remotes/origin/@BRNAME@ refs/gt/published/@BRNAME@; do
        wo=$(git -C @REPO@ rev-parse -q --verify "$wref" 2>/dev/null) && [ "$wo" = "$wc" ] && wpub=1
      done
      [ "$wpub" -eq 1 ] || { echo "WT kept commit que o origin não tem"; return 0; }
    fi
  done
  wo=$(GT_REMOTE_GIT=@GR@ @BIN@ wt-rm @RIG@ @NAME@ 2>&1) || { echo "WT kept wt-rm falhou: $(printf %s "$wo" | tail -n 1)"; return 0; }
  [ -z "$wb" ] || git -C @REPO@ update-ref -d @BRREF@ "$wb" 2>/dev/null
  echo "WT removed"
}
"""
# o ssh leva `sh -c '<RUNNER>'` (uma string, qualquer shell de login a entende) e o script vai pela entrada padrão: não há limite de
# argv (o prompt tem dezenas de KB) e o script lê a entrada inteira ANTES de rodar, então comando nenhum dele a come.
RUNNER = 'umask 077; f=$(mktemp) || exit 125; cat >"$f"; sh "$f" </dev/null; rc=$?; rm -f "$f"; exit $rc'
PRELUDE = r"""PATH="@PATHX@$HOME/.local/bin:$HOME/go/bin:/usr/local/bin:$PATH"; export PATH
T() { tmux -L @SOCK@ "$@"; }
sessions() { o=$(T list-sessions -F '#{session_name}' 2>&1) && { [ -z "$o" ] || printf '%s\n' "$o"; return 0; }
  case "$o" in *"no server running"*|*"error connecting to"*"(No such file or directory)"*) return 0;; esac; printf '%s\n' "$o" >&2; return 1; }
has() { s=$(sessions) || return 2; printf '%s\n' "$s" | grep -qxF -- "$1"; }
live() { has "$1"; r=$?; [ "$r" -ne 1 ] || exit 0; [ "$r" -eq 0 ] || exit 1; }
tree() { ps -e -o pid= -o ppid= | awk -v r="$1" '{p[$1]=$2} END{for(i in p){q=i;while(q!=""&&q!=0&&q!=1){if(q==r){print i;break};q=p[q]}}}'; }
hasproc() { ps -e -o pid= -o ppid= -o args= | awk -v r="$1" -v want="$2" 'BEGIN{n=split(want,w,",");for(i=1;i<=n;i++)W[w[i]]=1}
  {p[$1]=$2;a=$3;sub(/.*\//,"",a);A[$1]=a} END{for(i in p){q=i;while(q!=""&&q!=0&&q!=1){if(q==r){if(A[i] in W)f=1;break};q=p[q]}} print f?"true":"false"}'; }
echo @@GC-BEGIN@@
(
command -v tmux >/dev/null 2>&1 || { echo "tmux não está instalado no host" >&2; exit 127; }
"""
q = shlex.quote


class Fail(Exception):
    """Erro esperado: a mensagem vai para stderr, exit 1 (o engine a mostra no erro da operação)."""


class Unreachable(Fail):
    """O host não respondeu (ssh 255 ou tempo esgotado): a ÚNICA falha que um host `sleeps` pode tirar da lista em silêncio."""


def load_config() -> tuple:
    """(cidade, caminho, objeto) da configuração; ausente ou ilegível = Fail."""
    city = os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[0])))
    path = os.environ.get("GC_SSH_CONFIG") or os.path.join(city, ".gc", "session-ssh.json")
    try:
        with open(path) as f:
            raw = json.load(f)
    except FileNotFoundError:
        raise Fail(f"sem configuração: {path} não existe (ver docs/runbooks/gc-session-ssh.md)")
    except (OSError, ValueError) as e:
        raise Fail(f"configuração ilegível em {path}: {e}")
    return city, path, raw if isinstance(raw, dict) else {}


class Cfg:
    def __init__(self, host: str = "", session: str = "") -> None:
        self.city_guess, path, raw = load_config()
        self.names = sorted(raw["hosts"]) if isinstance(raw.get("hosts"), dict) else []
        # host: argumento explícito (gate <host>) > $GC_SSH_HOST > o que o NOME da sessão pede (`…-remote-<host>-…`) > default_host
        self.host = host or os.environ.get("GC_SSH_HOST") or self.host_of(session) or raw.get("default_host")
        h = (raw.get("hosts") or {}).get(self.host) if isinstance(raw.get("hosts"), dict) else None
        if not isinstance(h, dict):
            raise Fail(f"host {self.host!r} não está em {path}")
        self.ssh = self.need(h, "ssh", HOST_RE)
        self.root = self.need(h, "remote_root", PATH_RE).rstrip("/")
        self.home = self.need(h, "remote_home", PATH_RE).rstrip("/")
        self.socket = self.need(h, "socket", NAME_RE, "gc-remote")
        cap = h.get("cap")
        if not isinstance(cap, int) or isinstance(cap, bool) or cap < 1:
            raise Fail(f"host {self.host}: 'cap' (teto de sessões) ausente ou inválido — sem teto não abre sessão")
        self.cap = cap
        self.timeout, self.start_timeout, self.connect_timeout = (self.num(h, k, d) for k, d in
                                                                  (("timeout", 25), ("start_timeout", 60), ("connect_timeout", 10)))
        self.ssh_opts = [str(x) for x in h.get("ssh_opts") or []]
        self.env_allow = set(h.get("env_allow") or [])
        self.mini_home = os.path.realpath(h.get("mini_home") or os.path.expanduser("~"))
        # host que é o notebook do Athos (ga-w7qwl1): PATH extra (Homebrew não está no PATH do ssh sem login), regra de presença no
        # start, vigia de prioridade na sessão, e `sleeps` = pode estar dormindo/fora (ver list-running)
        self.path_extra = [self.need({"x": x}, "x", PATH_RE) for x in h.get("path_extra") or []]
        for k in ("presence_gate", "sleeps"):  # "true" (texto) não pode desligar em silêncio a regra que protege o Athos
            if k in h and not isinstance(h[k], bool):
                raise Fail(f"host {self.host}: '{k}' tem que ser true ou false ({h[k]!r})")
        self.gate, self.sleeps = h.get("presence_gate", False), h.get("sleeps", False)
        if self.sleeps and not self.gate:  # notebook sem a regra de presença abriria sessão com o Athos no teclado
            raise Fail(f"host {self.host}: 'sleeps' (notebook) exige presence_gate true")
        self.plib = self.need(h, "presence_lib", PATH_RE, self.home + "/gt-remote/bin/mbp-presence.sh")
        self.gate_cmd = h.get("gate_cmd") or [os.path.join(self.city_guess, "scripts", "mbp-run.sh"), "--check"]
        if not isinstance(self.gate_cmd, list) or not all(isinstance(x, str) and x for x in self.gate_cmd):
            raise Fail(f"host {self.host}: 'gate_cmd' tem que ser uma lista de textos")
        self.watch_s = self.num(h, "watch_s", 5)
        self.shim = isinstance(h.get("shim"), dict)  # bloco `shim` = o mini PUXA os pedidos de bd/gc das sessões (remote-shim-pump.py); sem ele, nada muda
        rb = h.get("real_sessions_released_by")
        self.released = rb.strip() if isinstance(rb, str) else ""  # só a decisão explícita do Mayor liga; ausente/vazio/não-texto = desligado
        # preparo do worktree no start (identidade git + confiança da pasta): LIGADO por padrão; o notebook do Athos (presence_gate) tem a identidade e a confiança DELE,
        # que o provider não escreve. `worktree_prepare` explícito vale nos dois sentidos; texto no lugar de true/false não desliga em silêncio (como presence_gate).
        if "worktree_prepare" in h and not isinstance(h["worktree_prepare"], bool):
            raise Fail(f"host {self.host}: 'worktree_prepare' tem que ser true ou false ({h['worktree_prepare']!r})")
        self.prepare = h.get("worktree_prepare", not self.gate)
        # papel → rig dos worktrees que o PROVIDER cria no start e recolhe no stop (ga-2hd02v.1.7): ausente → {} e nenhuma sessão ganha worktree (tudo como sempre foi); forma errada → recusa, nunca "ausente"
        wr = h.get("worktree_rigs", {})
        if not isinstance(wr, dict) or not all(isinstance(k, str) and ROLE_RE.fullmatch(k) and isinstance(v, str) and RIG_RE.fullmatch(v) for k, v in wr.items()):
            raise Fail(f"host {self.host}: 'worktree_rigs' tem que ser um objeto papel → rig, ex.: {{'dog': 'gascity'}} (papel [a-z][a-z0-9-]*, rig no formato do hetzner-remote-git.sh) ({wr!r})")
        self.wt_rigs = wr
        base = os.environ.get("GC_EXEC_STATE_DIR") or os.path.join(self.city_guess, ".gc", "runtime", "session-ssh")
        self.state = os.path.join(base, re.sub(r"[^A-Za-z0-9_.-]", "_", str(self.host)))

    def host_of(self, session: str) -> str:
        m = re.search(r"-remote-([A-Za-z0-9_]+)(-|$)", session or "")
        if m and m.group(1).isdigit():  # <papel>-remote-<n>: o número é o índice do pool, não um host → $GC_SSH_HOST/default_host
            return ""
        if m and m.group(1) not in self.names:
            # O engine NOMEIA a sessão de pool <modelo>-<cauda da bead> (dog-remote-gapxi4ls) ou <modelo>-adhoc-<10> (names.go: ReadableAutoSessionName, GenerateAdhocExplicitName):
            # a cauda no FIM do nome, ou `adhoc`, não pede host. Pedido de host é o documentado, <papel>-remote-<host>-<n>, e host fora da config continua recusando.
            if m.group(2) == "" or m.group(1) == "adhoc":
                return ""
            raise Fail(f"sessão {session}: o nome pede o host {m.group(1)!r}, que não está na config ({', '.join(self.names) or 'sem hosts'})")
        return m.group(1) if m else ""

    def need(self, h: dict, key: str, rx: re.Pattern, default: str = "") -> str:
        v = h.get(key, default)
        if not isinstance(v, str) or not rx.fullmatch(v) or v in ("/", "") or v.startswith("-"):
            raise Fail(f"host {self.host}: '{key}' ausente ou inválido ({v!r})")
        return v

    def num(self, h: dict, key: str, default: int) -> int:
        v = h.get(key, default)
        if not isinstance(v, int) or isinstance(v, bool) or not 1 <= v <= 600:
            raise Fail(f"host {self.host}: '{key}' tem que ser um inteiro de 1 a 600 ({v!r})")
        return v

    def mkstate(self, *sub: str) -> str:
        d = os.path.join(self.state, *sub)
        os.makedirs(d, 0o700, exist_ok=True)
        return d

    def log(self, msg: str) -> None:
        try:
            with open(os.path.join(self.mkstate(), "session-ssh.log"), "a") as f:
                f.write(f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {self.host} {msg}\n")
        except OSError:
            pass  # o log é auxiliar: falhar em gravá-lo não pode virar falha da operação


    def event(self, kind: str, name: str, **kw) -> None:
        """Uma linha por fato em <estado>/events.jsonl (started, refused, stopped): é a fonte do placar por host (session-host-scoreboard.py)."""
        try:
            with open(os.path.join(self.mkstate(), "events.jsonl"), "a") as f:
                f.write(json.dumps(dict(ts=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), host=self.host, session=name,
                                        event=kind, **kw), ensure_ascii=False) + "\n")
        except OSError:
            pass  # auxiliar, como o log

    def mark(self, name: str, on: bool) -> None:
        """Sessões que ESTE provider abriu e ainda não parou, no mini: é o que separa "host fora do ar, sem nada nosso lá" de "não sei"."""
        try:
            if on:
                f = os.path.join(self.mkstate("running"), name)
                open(f, "a").close()
                os.utime(f)  # a idade do registro decide o acerto do list-running
            else:
                os.unlink(os.path.join(self.state, "running", name))
        except OSError:
            pass

    def known(self) -> bool:
        try:
            return bool(os.listdir(os.path.join(self.state, "running")))
        except FileNotFoundError:
            return False
        except OSError:
            return True  # não consegui ler o registro: não sei, e "não sei" não vira "nada lá"


# ---------- transporte ----------

def ssh_argv(cfg: Cfg, tty: bool = False) -> list:
    a = [os.environ.get("GC_SSH_BIN") or "ssh", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={cfg.connect_timeout}",
         "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=3"]
    cm = os.path.join(os.path.expanduser("~"), ".ssh", "cm")  # o mesmo ControlPath do mbp-run.sh: a conexão é reaproveitada
    try:
        os.makedirs(cm, 0o700, exist_ok=True)
        a += ["-o", "ControlMaster=auto", "-o", f"ControlPath={cm}/%C", "-o", "ControlPersist=600"]
    except OSError:
        pass  # sem multiplexar ainda funciona, só mais devagar
    return a + (["-t"] if tty else []) + cfg.ssh_opts + [cfg.ssh]


def remote(cfg: Cfg, body: str, timeout: int = 0, dry: bool = False) -> tuple:
    """Roda `body` (sh) no host e devolve (rc, saída entre marcadores, stderr). ssh que falha ou não responde → Fail."""
    script = PRELUDE.replace("@SOCK@", q(cfg.socket)).replace("@PATHX@", "".join(d + ":" for d in cfg.path_extra)) + body + f"\n)\nrc=$?\necho {END}\nexit $rc\n"
    argv = ssh_argv(cfg) + ["sh -c " + q(RUNNER)]
    if dry:
        print(json.dumps({"ssh": argv, "script": script}, indent=2))
        return 0, "", ""
    t = timeout or cfg.timeout
    try:
        p = subprocess.run(argv, input=script.encode(), capture_output=True, timeout=t)
    except subprocess.TimeoutExpired:
        raise Unreachable(f"host {cfg.host} ({cfg.ssh}) não respondeu em {t}s por ssh")
    except OSError as e:
        raise Fail(f"não consegui rodar ssh: {e}")
    err = p.stderr.decode("utf-8", "replace").strip()
    if p.returncode == 255:
        raise Unreachable(f"ssh para o host {cfg.host} ({cfg.ssh}) falhou: {err or 'sem mensagem'}")
    lines = p.stdout.decode("utf-8", "replace").split("\n")
    if BEGIN not in lines or END not in lines:
        raise Fail(f"resposta de {cfg.host} sem marcadores (rc={p.returncode}): {err or 'sem mensagem'}")
    return p.returncode, "\n".join(lines[lines.index(BEGIN) + 1:len(lines) - 1 - lines[::-1].index(END)]), err


def run(cfg: Cfg, what: str, body: str, dry: bool, timeout: int = 0, ok: tuple = (0,)) -> tuple:
    rc, out, err = remote(cfg, body, timeout, dry)
    if rc not in ok:
        raise Fail(f"{what} em {cfg.host} falhou (rc={rc}): {err or out or 'sem mensagem'}")
    return rc, out, err


def tgt(name: str) -> str:
    return q("=" + name)  # sessão pelo nome EXATO (sem o '=' o tmux casa por prefixo)


def ptgt(name: str) -> str:
    return q("=" + name + ":")  # idem para alvo de painel/janela: '=nome' sozinho não resolve ("can't find pane"), '=nome:' sim


def check_name(name: str) -> str:
    if not NAME_RE.fullmatch(name or ""):
        raise Fail(f"nome de sessão inválido: {name!r}")
    return name


# ---------- start ----------

class Mapper:
    """As regras de caminho do remote-bundle-build.py (mesma fronteira nos dois lados), mais o arquivo de --settings da cidade."""

    def __init__(self, cfg: Cfg, city: str) -> None:
        cities = list(dict.fromkeys([city, os.path.realpath(city)]))
        self.rules = [(f"{c}/.gc/settings.json", cfg.root + "/city/settings.json") for c in cities]
        for c in cities:
            self.rules += [(c, cfg.root + "/city"), (os.path.dirname(c), cfg.root + "/work")]
        self.rules.append((cfg.mini_home, cfg.home))

    def map(self, s: str) -> str:
        for old, new in self.rules:
            s = re.sub(r"(?<![\w.-])" + re.escape(old) + r"(?![\w.-])", lambda _m, new=new: new, s)
        return s


def plan_start(cfg: Cfg, name: str, req: dict) -> dict:
    env_in = req.get("env") or {}
    if not isinstance(env_in, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in env_in.items()):
        raise Fail("start: 'env' tem que ser um objeto de strings")
    for k in ("work_dir", "command", "prompt_suffix", "prompt_flag"):
        if not isinstance(req.get(k) or "", str):
            raise Fail(f"start: '{k}' tem que ser texto")
    m = Mapper(cfg, env_in.get("GC_CITY") or os.environ.get("GC_CITY") or cfg.city_guess)
    workdir = m.map(req.get("work_dir") or "") or cfg.home
    command = re.sub("^" + re.escape(cfg.root + "/city") + POOL_WRAPPER + r"(?=\s|$)", "claude", m.map(req.get("command") or ""))
    if not command.strip():
        raise Fail("start sem command")
    env, dropped = {}, []
    for k in sorted(env_in):
        if not ENV_KEY.fullmatch(k) or not ENV_OK.fullmatch(k) or (SECRETISH.search(k) and k not in cfg.env_allow):
            dropped.append(k)
        else:
            env[k] = m.map(env_in[k])
    for what, v in [("work_dir", workdir), ("command", command)] + [(f"env {k}", v) for k, v in env.items()]:
        # o caminho do mini não existe no host: recusa em vez de abrir uma sessão que cairia no primeiro uso. Num host cujo home também
        # é /Users/<x> (o MBP), o home dele é o único /Users/ que vale; o de outro usuário continua recusado
        if any(u != cfg.home for u in re.findall(r"/Users/[A-Za-z0-9_.-]+", v)):
            raise Fail(f"start recusado: {what} ainda tem caminho do mini depois da reescrita: {v[:120]!r}")
    suffix, flag = m.map(req.get("prompt_suffix") or ""), req.get("prompt_flag") or ""
    line = command + (f" {flag} {suffix}" if flag and suffix else f" {suffix}" if suffix else "")
    return {"work_dir": workdir, "command": line, "env": env, "env_dropped": dropped,
            "ignored": [k for k in IGNORED if req.get(k)], "cap": cfg.cap, "socket": cfg.socket}


# Vigia de presença (hosts com presence_gate), um por sessão: se o Athos voltar ou pausar, a ÁRVORE de processos da sessão cai para
# prioridade de fundo (renice 19 + taskpolicy -b, o mesmo do mbp_supervise do mbp-run.sh) e nunca volta a subir; termina com o lançador.
# Os argumentos: $1 = biblioteca de presença (a do mbp-run.sh, em ~/gt-remote/bin), $2 = pid do lançador, $3 = intervalo em segundos.
WATCH = r'''export PRESENCE_LIB_ONLY=1; . "$1" || exit 0; me=$2
while kill -0 "$me" 2>/dev/null; do
  presence_eval
  if [ "$PR_MODE" != livre ] || [ "$PR_PAUSED" = 1 ]; then
    for p in $(ps -e -o pid= -o ppid= | awk -v r="$me" '{p[$1]=$2} END{for(i in p){q=i;while(q!=""&&q!=0&&q!=1){if(q==r){print i;break};q=p[q]}}}'); do
      [ "$p" = "$$" ] || { renice -n 19 -p "$p"; taskpolicy -b -p "$p"; } >/dev/null 2>&1
    done
  fi
  sleep "$3"
done'''


def launcher(cfg: Cfg, name: str, p: dict) -> str:
    exitf = f"{cfg.root}/run/{name}.exit"
    try:
        first = (shlex.split(p["command"]) or [""])[0]
    except ValueError:  # aspas que não fecham: o sh do host é quem vai dizer; só não há o que conferir antes
        first = ""
    out = ["#!/bin/sh", 'rm -f -- "$0"', f"cd {q(p['work_dir'])} || exit 1"]
    out += [f"unset {k}" if v == "" else f"export {k}={q(v)}" for k, v in p["env"].items()]
    if first and "=" not in first and first not in ("env", "exec"):
        out.append(f'command -v {q(first)} >/dev/null 2>&1 || {{ echo "comando não encontrado: "{q(first)} >{q(exitf)}; exit 127; }}')
    if cfg.gate:
        out.append(f"bash -c {q(WATCH)} _ {q(cfg.plib)} $$ {cfg.watch_s} </dev/null >/dev/null 2>&1 &")
    run_cmd = f"{'nice -n 10 ' if cfg.gate else ''}sh -c {q(p['command'])}"  # notebook do Athos: começa em nice 10 (mbp-run.sh, modo livre)
    return "\n".join(out + [run_cmd, "rc=$?", f'[ "$rc" -eq 0 ] || echo "saiu com $rc" >{q(exitf)}', 'exit "$rc"']) + "\n"


def gate_check(cfg: Cfg) -> dict:
    """A regra do Athos para o MBP (ga-77c1qg), a mesma do mbp-run.sh: só evidência POSITIVA de "Athos fora e MBP saudável" libera.
    Pausa, bandeira desligada, em uso, sem saúde ou qualquer coisa que a checagem não deixe ler recusa (o lado que protege o Athos)."""
    def no(why: str) -> dict:
        return {"host": cfg.host, "ok": False, "reason": why, "slot_cap": None}
    try:
        r = subprocess.run(cfg.gate_cmd, capture_output=True, timeout=60, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return no("a checagem de presença do MBP não respondeu em 60s")
    except OSError as e:
        return no(f"não consegui rodar a checagem de presença ({e})")
    kv = dict(l.split("=", 1) for l in r.stdout.decode("utf-8", "replace").splitlines() if "=" in l)
    cap = kv.get("slot_cap", "")
    if r.returncode == 99:
        return no("MBP desligado ou pausado (bandeira ou pausa do Athos)")
    if r.returncode != 0:
        return no(f"MBP sem saúde ou fora do ar (rc {r.returncode})")
    if kv.get("presence") != "livre":
        return no(f"Athos está no MBP (presença={kv.get('presence') or 'ilegível'}, motivo={kv.get('presence_why') or '?'})")
    if kv.get("paused") != "0" or kv.get("paused_local") != "0":
        return no("pausa do Athos ativa")
    if kv.get("offload_flag") != "on":
        return no("bandeira mbp-offload desligada")
    if not cap.isdigit() or int(cap) < 1:
        return no(f"teto de slots ilegível ou zero na checagem (slot_cap={cap!r})")
    return {"host": cfg.host, "ok": True, "reason": "Athos fora e MBP saudável", "slot_cap": int(cap)}


def op_gate(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    """`gate <host>`: o veredito de um start AGORA, sem abrir nada (para o teto/escala do pool): JSON, exit 0 libera, 1 recusa,
    2 = não consultei (dry-run num host com regra de presença: um GC_SSH_DRYRUN vazado num pool não pode virar "sempre libera")."""
    if cfg.gate and dry:
        print(json.dumps({"host": cfg.host, "ok": None, "slot_cap": None, "cap": cfg.cap, "reason": "dry-run: não consultei a presença"},
                         ensure_ascii=False, sort_keys=True))
        return 2
    v = gate_check(cfg) if cfg.gate else {"host": cfg.host, "ok": True, "slot_cap": None, "reason": "este host não tem regra de presença"}
    print(json.dumps(dict(v, cap=cfg.cap), ensure_ascii=False, sort_keys=True))
    return 0 if v["ok"] else 1


def real_gate(cfg: Cfg, name: str, work_dir: str) -> str:
    """'' = sessão de teste (passa); senão o trecho de sh que confere o guarda de clone NO host. Sem liberação, ou sem como conferir → Fail."""
    if TEST_RE.fullmatch(name):
        return ""
    if not cfg.released:
        raise Fail(f"sessão real {name!r} recusada em {cfg.host}: falta 'real_sessions_released_by' na configuração do host (decisão explícita do "
                   f"Mayor, ga-2hd02v.1.5); por enquanto só abrem remote-e2e-<x> e remote-test-<x>")
    try:
        with open(os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), GUARD), "rb") as f:
            sha = hashlib.sha256(f.read()).hexdigest()
    except OSError as e:
        raise Fail(f"sessão real {name!r} recusada: não consegui ler o {GUARD} do repositório para conferir o do host: {e}")
    g, st = q(f"{cfg.home}/.claude/hooks/{GUARD}"), q(f"{cfg.home}/.claude/settings.json")
    return (f'h=$( {{ sha256sum {g} || shasum -a 256 {g}; }} 2>/dev/null | cut -d" " -f1)\n'
            f'[ "$h" = {sha} ] || {{ echo "sessão real {name} recusada: {GUARD} ausente ou diferente do repositório no host" >&2; exit {EX_POLICY}; }}\n'
            f'o=$(python3 -I {g} --selfcheck {st} {q(work_dir)} 2>&1) || {{ echo "sessão real {name} recusada: o --selfcheck do guarda reprovou as settings do host: $o" >&2; exit {EX_POLICY}; }}\n')


def shim_pump(cfg: Cfg) -> None:
    """Sobe o puxador de pedidos do MBP (idempotente: se já há um, não faz nada). Best-effort: a sessão já abriu, e sem o puxador só
    os atalhos bd/gc dela falham na hora (rc 75, nada enviado) — por isso falhar aqui não desfaz o start, só fica no log."""
    try:
        r = subprocess.run([sys.executable, "-I", os.path.join(os.path.dirname(os.path.realpath(__file__)), "remote-shim-pump.py"), "ensure", "--host", cfg.host],
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=15)
        if r.returncode != 0:
            cfg.log(f"shim-pump ensure falhou rc={r.returncode}: {r.stderr.decode(errors='replace').strip()[:160]}")
    except (OSError, subprocess.SubprocessError) as e:
        cfg.log(f"shim-pump ensure não rodou: {e}")


def prepare_script(cfg: Cfg) -> str:
    """'' = este host não prepara (notebook do Athos); senão o trecho de sh do PREPARE_SH com os marcadores do start ainda por substituir."""
    if not cfg.prepare:
        return ""
    return PREPARE_SH.replace("@TRUSTFILE@", q(f"{cfg.home}/.claude.json")).replace("@EXPREP@", str(EX_PREP))


def managed_worktree(cfg: Cfg, name: str) -> dict:
    """{} = a sessão NÃO ganha worktree do provider (sem `-remote-` no nome, ou papel fora de `worktree_rigs`: tudo como sempre foi); senão onde ele fica e o que o start e o stop precisam."""
    m = re.match(r"(.+?)-remote-", name)
    rig = cfg.wt_rigs.get(m.group(1)) if m else None  # vazio (sem papel, papel sem mapa) → {}; config mal formada já recusou no Cfg
    if not rig:
        return {}
    if not WT_NAME_RE.fullmatch(name):
        raise Fail(f"sessão {name!r}: o nome vira o do worktree e do branch worker/<nome> e tem que casar [a-z0-9][a-z0-9._-]{{0,60}} (minúsculas) — o papel {m.group(1)!r} tem worktree do provider")
    gr = f"{cfg.home}/gt-remote/git"  # o padrão do hetzner-remote-git.sh (GT_REMOTE_GIT), passado explícito nas chamadas
    return {"rig": rig, "git": gr, "path": f"{gr}/{rig}/wt/{name}", "repo": f"{gr}/{rig}/repo.git", "branch": f"worker/{name}",
            "bin": f"{cfg.home}/gt-remote/bin/hetzner-remote-git.sh"}


def wtclean_sh(wt: dict, name: str) -> str:
    """A função `wtclean` do host (WTCLEAN_SH) com os valores desta sessão."""
    return (WTCLEAN_SH.replace("@WT@", q(wt["path"])).replace("@REPO@", q(wt["repo"])).replace("@BRREF@", q("refs/heads/" + wt["branch"])).replace("@BRNAME@", q(wt["branch"]))
            .replace("@GR@", q(wt["git"])).replace("@BIN@", q(wt["bin"])).replace("@RIG@", q(wt["rig"])).replace("@NAME@", q(name)))


def wtadd_sh(wt: dict, name: str) -> str:
    """O wt-add NO MESMO script do start, depois do teto e da existência e ANTES do guarda de clone (que olha o checkout: com a pasta ainda ausente ele aprovaria sem ver o disableAllHooks que vem no repositório).
    Se o start falhar daqui em diante, o EXIT recolhe o worktree que ele criou (wtclean mantém o que tiver trabalho)."""
    return (wtclean_sh(wt, name)
            + f"GT_REMOTE_GIT={q(wt['git'])} {q(wt['bin'])} wt-add {q(wt['rig'])} {q(name)} || {{ echo \"worktree da sessão {name} recusado: o wt-add de {wt['rig']} falhou (mensagem acima)\" >&2; exit {EX_PREP}; }}\n"
            + "trap '[ \"$?\" -eq 0 ] || wtclean >&2' EXIT\n")


def op_start(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except ValueError as e:
        raise Fail(f"start: JSON inválido na entrada: {e}")
    if not isinstance(req, dict):
        raise Fail("start: a entrada tem que ser um objeto JSON")
    p = plan_start(cfg, name, req)
    wt = managed_worktree(cfg, name)
    if wt:
        p["work_dir"] = wt["path"]  # a pasta do template não existe no host e não é o worktree: a sessão abre no que o wt-add cria
    start_timeout = max(cfg.start_timeout, WT_START_FLOOR) if wt else cfg.start_timeout  # o wt-add puxa o espelho antes de criar: sessão com worktree do provider nunca tem menos que o piso
    cap = cfg.cap
    gate, would_refuse = "", None  # `gate` = o trecho de sh do guarda de clone (sessão real); `cfg.gate` = a regra de presença do MBP — duas regras, as DUAS valem
    if dry:  # vazio → a recusa local não dispararia (None; o sha e o --selfcheck do guarda só rodam no host, no start de verdade); falhou → o motivo, em vez de um dry-run que finge que abriria
        try:
            real_gate(cfg, name, p["work_dir"])
        except Fail as e:
            would_refuse = str(e)
    else:
        gate = real_gate(cfg, name, p["work_dir"])  # política local primeiro: sessão real sem liberação nem chega a consultar a presença
    if cfg.gate and not dry:  # regra de presença: a cada start, na hora (é o que faz "o Athos voltou → nada novo" valer já na próxima tentativa)
        g = gate_check(cfg)
        if not g["ok"]:
            cfg.event("refused", name, reason=g["reason"])
            raise Fail(f"host {cfg.host}: não abro sessão nova — {g['reason']}")
        cap = min(cap, g["slot_cap"])  # o teto de RAM do mbp-run.sh (slot_cap) também vale para as sessões
    run_dir, exitf = f"{cfg.root}/run", f"{cfg.root}/run/{name}.exit"
    lpath = f"{run_dir}/{name}.sh"
    if dry:
        wtd = {"worktree": {"rig": wt["rig"], "path": wt["path"], "add": f"{wt['bin']} wt-add {wt['rig']} {name}", "rm": f"{wt['bin']} wt-rm {wt['rig']} {name}", "start_timeout": start_timeout}} if wt else {}
        print(json.dumps(dict(p, **wtd, host=cfg.host, session=name, session_kind="teste" if TEST_RE.fullmatch(name) else "real", would_refuse=would_refuse, launcher=launcher(cfg, name, p).split("\n"),
                              prepare=({"git_user": name, "git_email": f"{name}@gastown.invalid", "trust_file": f"{cfg.home}/.claude.json", "work_dir": p["work_dir"]} if cfg.prepare else None),
                              gate=cfg.gate_cmd if cfg.gate else None, path_extra=cfg.path_extra,
                              tmux=["tmux", "-L", cfg.socket, "new-session", "-d", "-s", name, "-c", p["work_dir"], f"sh {lpath}"],
                              ssh=ssh_argv(cfg)), indent=2, sort_keys=True))
        return 0
    body = """s=$(sessions) || exit 1
@GATE0@printf '%s\\n' "$s" | grep -qxF -- @NAME@ && { echo "session @NAME@ already exists" >&2; exit 11; }
n=$(printf '%s\\n' "$s" | grep -c .)
[ "$n" -lt @CAP@ ] || { echo "host @HOST@ está no teto: $n de @CAP@ sessões" >&2; exit 10; }
@WTADD@@GATE1@@PREP@@PLIBCHECK@mkdir -p @RUN@ @WORKDIR@ && chmod 700 @RUN@ || exit 1
rm -f @EXITF@; printf %s @B64@ | base64 -d >@LAUNCH@ || exit 1
T new-session -d -s @NAME@ -c @WORKDIR@ "sh @LAUNCH@" || { rm -f @LAUNCH@; exit 1; }
sleep 1
T has-session -t @TGT@ 2>/dev/null || { echo "sessão @NAME@ terminou logo após abrir: $(cat @EXITF@ 2>/dev/null)" >&2; rm -f @LAUNCH@; exit 1; }"""
    plib = f'[ -r {q(cfg.plib)} ] || {{ echo "host @HOST@: sem a biblioteca de presença ({cfg.plib}); rode mbp-offload.sh install-mbp" >&2; exit 12; }}\n' if cfg.gate else ""
    body = body.replace("@PLIBCHECK@", plib).replace("@PREP@", prepare_script(cfg)).replace("@WTADD@", wtadd_sh(wt, name) if wt else "")
    for k, v in {"@NAME@": q(name), "@CAP@": str(cap), "@HOST@": q(cfg.host), "@RUN@": q(run_dir), "@WORKDIR@": q(p["work_dir"]),
                 "@EXITF@": q(exitf), "@LAUNCH@": q(lpath), "@TGT@": tgt(name),
                 "@B64@": q(base64.b64encode(launcher(cfg, name, p).encode()).decode())}.items():
        body = body.replace(k, v)
    body = body.replace("@GATE0@", "" if wt else gate).replace("@GATE1@", gate if wt else "")  # sessão com worktree do provider: o guarda de clone vem DEPOIS do wt-add
    with open(os.path.join(cfg.mkstate(), "lock"), "a") as lf:  # cap + criação são um passo só; entre processos do mini, um por vez
        fcntl.flock(lf, fcntl.LOCK_EX)
        # registra ANTES do ssh: um start ambíguo (ssh cai ou estoura o tempo depois do script já ter rodado no host) deixa o registro,
        # e o list-running com o host fora do ar diz "não sei" em vez de "nada nosso lá"; só uma recusa clara do host o apaga
        cfg.mark(name, True)
        rc, out, err = remote(cfg, body, start_timeout)
        if rc not in (0, EX_EXISTS):
            cfg.mark(name, False)
    if rc in (EX_CAP, EX_EXISTS, EX_POLICY, EX_PREP):
        if rc == EX_CAP:
            cfg.event("refused", name, reason="teto do host")
        if rc == EX_PREP:
            cfg.log(f"start {name} recusado: preparo do worktree falhou: {err[:300]}")
        raise Fail(err or f"start de {name} recusado em {cfg.host} (rc={rc}, sem mensagem)")
    if rc != 0:
        raise Fail(f"start em {cfg.host} falhou (rc={rc}): {err or out or 'sem mensagem'}")
    cfg.event("started", name)
    if cfg.shim:
        shim_pump(cfg)
    cfg.log(f"start {name} ok" + (f" worktree={out.strip()[:200]}" if wt and out.strip() else "") + (f" ignored={','.join(p['ignored'])}" if p["ignored"] else "") +
            (f" env_dropped={','.join(p['env_dropped'])}" if p["env_dropped"] else ""))
    return 0


# ---------- as demais operações ----------

def op_stop(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    body = """has @NAME@; [ $? -ne 2 ] || exit 1
pp=$(T list-panes -t @PTGT@ -F '#{pane_pid}' 2>/dev/null | head -1); pids=
[ -z "$pp" ] || pids=$(tree "$pp")
T kill-session -t @TGT@ 2>/dev/null
if [ -n "$pids" ]; then kill -TERM $pids 2>/dev/null; sleep 1; kill -KILL $pids 2>/dev/null; fi
rm -f @RUN@/@NAME@.sh @RUN@/@NAME@.exit
has @NAME@; [ $? -eq 1 ] || { echo "sessão @NAME@ continua aberta depois do stop" >&2; exit 1; }""".replace("@TGT@", tgt(name)).replace("@PTGT@", ptgt(name)).replace("@RUN@", q(cfg.root + "/run")).replace("@NAME@", name)
    wt = managed_worktree(cfg, name)
    if wt:  # só chega aqui com a sessão já fora (a conferência acima sai 1 se não): então recolhe o worktree, e o resultado NUNCA muda o rc do stop
        body += "\n" + wtclean_sh(wt, name) + "wtclean\nexit 0"
    _, out, _ = run(cfg, "stop", body, dry)
    if not dry:
        meta_clear(cfg, name)
        verdict = ([ln[3:] for ln in out.splitlines() if ln.startswith("WT ")] or ["sem resposta do recolhimento"])[-1] if wt else ""  # vazio (sem WT) → "sem resposta", nunca "removed"
        cfg.event("stopped", name, **({"worktree": verdict} if wt else {}))
        if wt:
            cfg.log(f"stop {name} worktree: {verdict}")
        cfg.mark(name, False)
    return 0


def op_interrupt(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    run(cfg, "interrupt", f"live {q(name)}; T send-keys -t {ptgt(name)} C-c 2>/dev/null; exit 0", dry)
    return 0


def op_is_running(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    # false = o tmux do host respondeu e a sessão não está na lista; tmux que não conseguiu olhar (has → 2) é erro, nunca "false"
    print(run(cfg, "is-running", f"has {q(name)}; case $? in 0) echo true;; 1) echo false;; *) exit 1;; esac", dry)[1])
    return 0


def op_process_alive(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    names = [n for n in sys.stdin.read().split() if re.fullmatch(r"[A-Za-z0-9._+-]+", n)]
    if not names:
        print("true")  # contrato do engine: sem nomes, vale
        return 0
    body = (f"has {q(name)}; r=$?; [ \"$r\" -ne 1 ] || {{ echo false; exit 0; }}; [ \"$r\" -eq 0 ] || exit 1\n"  # tmux sem resposta = erro, não "false"
            f"pp=$(T list-panes -t {ptgt(name)} -F '#{{pane_pid}}' 2>/dev/null | head -1); [ -n \"$pp\" ] || {{ echo false; exit 0; }}\n"
            f"hasproc \"$pp\" {q(','.join(names))}")
    print(run(cfg, "process-alive", body, dry)[1])
    return 0


def op_nudge(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    text = sys.stdin.buffer.read()
    if not text:
        return 0
    b = f"{cfg.socket}-{name}"
    body = (f"live {q(name)}\nprintf %s {q(base64.b64encode(text).decode())} | base64 -d | T load-buffer -b {q(b)} - || exit 1\n"
            f"T paste-buffer -d -p -b {q(b)} -t {ptgt(name)} || exit 1\nsleep 0.3; T send-keys -t {ptgt(name)} Enter")
    run(cfg, "nudge", body, dry)
    return 0


def op_send_keys(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    if args:
        run(cfg, "send-keys", f"live {q(name)}; for k in {' '.join(q(k) for k in args)}; do T send-keys -t {ptgt(name)} -- \"$k\" 2>/dev/null; done; exit 0", dry)
    return 0


def op_peek(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    n = int(args[0]) if args and re.fullmatch(r"-?\d+", args[0]) else 0
    print(run(cfg, "peek", f"T capture-pane -p -t {ptgt(name)} -S {-n if n > 0 else '-'}", dry)[1])
    return 0


def op_list_running(prefix: str, dry: bool) -> int:
    """Sessões de TODOS os hosts da config (ou só do $GC_SSH_HOST). Host que não responde = erro (o engine trata como lista parcial),
    nunca "vazio" — salvo um host `sleeps` (notebook) sem nenhuma sessão nossa registrada: ali "não responde" é só o notebook fora do ar."""
    if not re.fullmatch(r"[A-Za-z0-9_-]*", prefix or ""):
        raise Fail(f"prefixo inválido: {prefix!r}")
    cfg_hosts = load_config()[2].get("hosts")
    hosts = [os.environ["GC_SSH_HOST"]] if os.environ.get("GC_SSH_HOST") else sorted(cfg_hosts) if isinstance(cfg_hosts, dict) else []
    if not hosts:
        raise Fail("a configuração não tem nenhum host")
    bad = []
    for h in hosts:
        cfg = Cfg(host=h)
        t0 = time.time()
        try:
            _, out, _ = run(cfg, "list-running", "sessions", dry)
        except Unreachable as e:  # só "não respondeu"; resposta truncada, tmux ilegível ou ssh que nem roda continuam erro
            if cfg.sleeps and not cfg.known():
                cfg.log(f"list-running: host sem resposta e sem sessão nossa registrada, não conta: {e}")
            else:
                bad.append(str(e))
            continue
        except Fail as e:
            bad.append(str(e))
            continue
        live = [x for x in out.split("\n") if x]
        for x in live:
            if x.startswith(prefix):
                print(x)
        if not dry:  # o host respondeu: o registro de sessões abertas volta a ser o que o host de fato tem
            try:
                run_d = os.path.join(cfg.state, "running")
                for m in os.listdir(run_d):  # registro mais novo que a pergunta = start em curso que a lista não podia ver: fica
                    if m not in live and os.stat(os.path.join(run_d, m)).st_mtime < t0:
                        cfg.mark(m, False)
            except OSError:
                pass  # sem registro legível não há o que acertar; o próximo start o refaz
    if bad:
        raise Fail("; ".join(bad))
    return 0


def op_last_activity(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    out = run(cfg, "get-last-activity", f"live {q(name)}; T display-message -p -t {ptgt(name)} '#{{session_activity}}' 2>/dev/null; exit 0", dry)[1].strip()
    if out.isdigit():
        print(datetime.fromtimestamp(int(out), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    return 0


def op_clear_scrollback(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    run(cfg, "clear-scrollback", f"live {q(name)}; T clear-history -t {ptgt(name)} 2>/dev/null; exit 0", dry)
    return 0


def op_attach(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    argv = ssh_argv(cfg, tty=True) + [f"tmux -L {q(cfg.socket)} attach-session -t {tgt(name)}"]
    if dry:
        print(json.dumps(argv))
        return 0
    os.execvp(argv[0], argv)
    return 1


# ---------- meta (no mini; nada disto vai para o servidor) ----------

def meta_file(cfg: Cfg, name: str, key: str) -> str:
    if not KEY_RE.fullmatch(key or ""):
        raise Fail(f"chave de meta inválida: {key!r}")
    return os.path.join(cfg.state, "meta", name, key)


def meta_clear(cfg: Cfg, name: str) -> None:
    d = os.path.join(cfg.state, "meta", name)
    try:
        for f in os.listdir(d):
            os.unlink(os.path.join(d, f))
        os.rmdir(d)
    except FileNotFoundError:
        pass
    except OSError as e:
        raise Fail(f"não consegui limpar o meta de {name}: {e}")


def op_set_meta(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    path = meta_file(cfg, name, args[0] if args else "")
    cfg.mkstate("meta", name)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(sys.stdin.read())
    os.replace(tmp, path)
    return 0


def op_get_meta(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    try:
        with open(meta_file(cfg, name, args[0] if args else "")) as f:
            sys.stdout.write(f.read())
    except FileNotFoundError:
        pass  # chave ausente = vazio, como nos outros providers
    return 0


def op_remove_meta(cfg: Cfg, name: str, args: list, dry: bool) -> int:
    try:
        os.unlink(meta_file(cfg, name, args[0] if args else ""))
    except FileNotFoundError:
        pass
    return 0


# Só estas operações existem. As que o protocolo conhece e este provider NÃO serve (check-image, copy-to, watch-startup, run-live) e as
# desconhecidas caem fora daqui e saem com 2 ("não suportado") sem abrir ssh, sem ler a entrada, sem tocar em sessão.
OPS = {"gate": op_gate, "start": op_start, "stop": op_stop, "interrupt": op_interrupt, "is-running": op_is_running, "process-alive": op_process_alive,
       "nudge": op_nudge, "send-keys": op_send_keys, "peek": op_peek, "get-last-activity": op_last_activity,
       "clear-scrollback": op_clear_scrollback, "attach": op_attach, "set-meta": op_set_meta, "get-meta": op_get_meta,
       "remove-meta": op_remove_meta}
NAMELESS = {"list-running", "gate"}  # o 2º argumento é um prefixo (list-running) ou um host (gate), não um nome de sessão


def main(argv: list) -> int:
    args = argv[1:]
    dry = bool(args and args[0] == "--dry-run") or os.environ.get("GC_SSH_DRYRUN") == "1"
    args = args[1:] if args and args[0] == "--dry-run" else args
    if not args or (args[0] not in OPS and args[0] != "list-running"):
        return 2
    op, rest = args[0], args[1:]
    arg = rest[0] if rest else ""
    cfg = None
    try:
        if op == "list-running":
            return op_list_running(arg, dry)
        if op not in NAMELESS:
            check_name(arg)
        if op == "gate" and not arg:  # `gate "$H"` com H vazio: avaliar o default_host e dizer "libera" seria decidir sobre OUTRO host (gate ga-ie7fcr)
            sys.stderr.write("gc-session-ssh gate: falta o host (uso: gate <host>)\n")
            return 2
        cfg = Cfg(host=arg if op == "gate" else "", session="" if op == "gate" else arg)
        return OPS[op](cfg, arg, rest[1:], dry)
    except Fail as e:
        sys.stderr.write(f"gc-session-ssh {op}: {e}\n")
        try:
            (cfg or Cfg()).log(f"{op} {arg} FALHOU: {e}")
        except Fail:
            pass
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
