<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- ga-1h1b7vq. 600 s (10 min): bem acima da duração de uma rodada (2 curl de ≤ 10 s + 1 mail de ≤ 45 s, pior caso ~75 s); o lock de instância única cobre o resto.
       A 1ª leitura já compara com o IP liberado no firewall (semente 179.197.107.78), então RunAtLoad vale. Instalar e conferir: docs/runbooks/hetzner-fw-ip-watch.md. -->
  <key>Label</key><string>com.gascity.hetzner-fw-ip-watch</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/hetzner-fw-ip-watch.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/athos/gt/.gascity-gastown-hq</string>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/hetzner-fw-ip-watch.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/hetzner-fw-ip-watch.err</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key><string>/Users/athos</string>
    <key>GC_CITY_PATH</key><string>/Users/athos/gt/.gascity-gastown-hq</string>
    <key>BEADS_DOLT_AUTO_START</key><string>0</string>
  </dict>
</dict></plist>
