<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- ga-2w0hiow. 180 s: o guarda de clone do servidor Hetzner tem que ser o do repositório. O provider (gc-session-ssh, real_gate) recusa TODA sessão real quando o sha do
       remote-clone-guard.py do servidor difere do do repositório, e um merge nesse arquivo muda o do repositório na hora (a cidade roda in-place); sem este job o pool remoto parava
       até alguém rodar o push-bundle (29/10: 2h43 sem nenhum aviso). `sync-guard` compara o sha e, se difere, troca de forma atômica, roda o selfcheck do guarda NOVO contra o settings
       do servidor e REVERTE se reprovar; aviso por notify quando falha, quando troca e quando fica 30 min seguidos sem saber. Cada rodada imprime UMA linha no fim (stdout), exit 0 em dia ou atualizado, 1 reprovou, 3 não
       soube. Dura no máximo 30 s de leitura mais 90 s de instalação, menos que o intervalo, e uma segunda instância sai sem esperar (trava própria). Para só avisar, sem trocar nada,
       acrescente aos ProgramArguments o argumento check precedido de dois hifens. Instalar, conferir e retirar: docs/runbooks/hetzner-hardening.md (seção A trava no provider e como liberar).
       Registro na política do wait-for-dolt e no DPW: depois de instalado, como foi com o capacity-step. -->
  <key>Label</key><string>com.gascity.hetzner-guard-sync</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/hetzner-claude.py</string>
    <string>sync-guard</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/athos/gt/.gascity-gastown-hq</string>
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/hetzner-guard-sync.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/hetzner-guard-sync.err</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key><string>/Users/athos</string>
    <key>GC_CITY_PATH</key><string>/Users/athos/gt/.gascity-gastown-hq</string>
  </dict>
</dict></plist>
