<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.ask-athos-relay</string>
  <!-- ga-ij162cl (camadas 2 e 3): a cada 3 min leva ao Mayor a pergunta que um worker de pool tem para o Athos (bead com aguarda:athos, ou menu AskUserQuestion aberto no pane de uma sessao de pool).
       Contrato: cabecalho de scripts/ask-athos-relay.py; instalar e ler: docs/runbooks/ask-athos-relay.md. RunAtLoad e FALSE: a 1a rodada sai em 3 min, e quem carrega confere antes com o modo dry-run. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/ask-athos-relay.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/athos/gt/.gascity-gastown-hq</string>
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/ask-athos-relay.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/ask-athos-relay.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
    <key>BEADS_DOLT_AUTO_START</key>
    <string>0</string>
  </dict>
</dict>
</plist>
