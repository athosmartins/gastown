<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.gascity.order-exec-failure-watchdog</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/order-exec-failure-watchdog.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/athos/gt/.gascity-gastown-hq</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <!-- ga-u04vp/ga-9wv5: unset ProcessType defaults to Standard, which macOS DAS
       can defer indefinitely under load/thermal pressure ("pended nondemand
       spawn"). daemon-presence-watchdog went dark 2h24m this way once. This
       watchdog exists specifically to close a SILENT-failure blind spot
       (ga-q5t8r) — it would be self-defeating if it could itself go silently
       deferred. Interactive removes background resource limits so DAS stops
       treating this as deferrable background work. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/order-exec-failure-watchdog-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/order-exec-failure-watchdog-launchd.err</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key><string>/Users/athos</string>
  </dict>
</dict></plist>
