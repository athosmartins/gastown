{
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EndConversation",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "SendFeedback",
      "Workflow"
    ]
  },
  "remoteControlAtStartup": false,
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": ": home-scan-guard; P='/Users/athos/gt/.gascity-gastown-hq/scripts/home-scan-guard.sh'; [ -f \"$P\" ] || exit 0; exec /bin/bash \"$P\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": true,
  "claudeMdExcludes": [
    "/Users/athos/.claude/CLAUDE.md",
    "/Users/athos/gt/CLAUDE.md",
    "/Users/athos/gt/AGENTS.md"
  ],
