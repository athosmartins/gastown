{
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Agent",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EndConversation",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "ListAgents",
      "Monitor",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendFeedback",
      "Skill",
      "TaskStop",
      "WebFetch",
      "WebSearch",
      "Workflow"
    ]
  },
  "remoteControlAtStartup": false,
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "/Users/athos/.claude/CLAUDE.md",
    "/Users/athos/gt/CLAUDE.md",
    "/Users/athos/gt/AGENTS.md"
  ],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false
  }
}
