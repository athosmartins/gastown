<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.gate-health-monitor</string>

  <!-- Problem-only gate/pilot health monitor. Emits actionable alerts ONLY
       (silence = healthy). Outputs to StandardOutPath log:
         [GATE FAIL]      a review genuinely failed
         [REAL-JAM]       gate marker stuck queued/claimed (true wedge)
         [DELIVERY-FAIL]  delivery failed or HALTed
         [ENGINE-STALL]   gate dispatcher log silent >15min
         [GUARDIAN-STALL] guardian-dispatch.sh heartbeat stale >15min

       This daemon runs as a persistent loop (checks every 60s).
       KeepAlive restarts it if it exits unexpectedly.

       First-run procedure (read-only — safe to run directly):
         1. python3 scripts/gate-health-monitor.py   # verify output
         2. launchctl load ~/Library/LaunchAgents/com.gascity.gate-health-monitor.plist
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/gate-health-monitor.py</string>
  </array>

  <key>KeepAlive</key><true/>

  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/gate-health-monitor.log</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/gate-health-monitor.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
  </dict>
</dict>
</plist>
