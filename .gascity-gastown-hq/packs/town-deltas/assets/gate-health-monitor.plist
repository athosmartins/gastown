<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.gate-health-monitor</string>

  <!-- Problem-only gate/pilot health monitor. Long-running polling loop
       (sleeps 60s between checks). Emits a line ONLY for actionable problems —
       silence means healthy. Each alert is also pushed via notify CLI to reach
       Athos on mobile. Alerts on:
         [GATE FAIL]      a review genuinely failed
         [REAL-JAM]       gate marker stuck queued/claimed >25min (true wedge)
         [GATE-ERROR]     gate marker stuck in gate-status:error >10min (dispatch failure)
         [DELIVERY-FAIL]  delivery failed or HALTed
         [ENGINE-STALL]   gate dispatcher log silent >15min
         [GUARDIAN-STALL] guardian-dispatch.sh heartbeat stale >15min (watcher is dead)

       KeepAlive restarts the loop if it exits unexpectedly; RunAtLoad starts it
       on load. /usr/bin/python3 (system) — always present, no brew dependency;
       matches every other python plist in this town. The script derives its
       paths from __file__, but WorkingDirectory is set for belt-and-suspenders.

       First-run procedure (read-only — safe to run directly):
         1. python3 scripts/gate-health-monitor.py   # verify output
         2. launchctl load ~/Library/LaunchAgents/com.gascity.gate-health-monitor.plist
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/gate-health-monitor.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/athos/gt/.gascity-gastown-hq</string>

  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/gate-health-monitor-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/gate-health-monitor-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
  </dict>
</dict>
</plist>
