<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.inflight-reclaim-guard</string>

  <!-- Pilot-side zombie reclaim guard (ga-se62o). Poll loop (~5min).
       Detects story:in-flight + pilot:dispatched beads whose builder died or
       never engaged, and reclaims them so the Pilot can re-dispatch.
       Analog of quality-gate-guard.sh Vector A for the Pilot lane.
       Silence = healthy. Emits only on action:
         [INFLIGHT-RECLAIM] [RECLAIMED]   stripped lifecycle labels from zombie bead
         [INFLIGHT-RECLAIM] [RECLAIM-FAILED] bd label ops failed; needs manual check
         [INFLIGHT-RECLAIM] [ESCALATED]   reclaim cap (3) hit — needs human/Mayor
       Each alert line is also sent via notify CLI to reach Athos on mobile. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/inflight-reclaim-guard.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/athos/gt/.gascity-gastown-hq</string>

  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/inflight-reclaim-guard-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/inflight-reclaim-guard-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
  </dict>
</dict>
</plist>
