<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.claude-account-relog</string>

  <!-- Auto-relog into a Claude account with more quota when the active account
       hits the apex of its 5h-window limit (ga-jf689). Polls every 5min; runs
       claude-quota-check.sh (ga-wjlv9) and, on a real apex event, swaps the
       Keychain credential to a pool account with headroom so reviewers/dogs/
       workers keep going instead of stalling the gate. If no account has
       headroom it defers to the PAUSE path (ga-x3nmz).

       FAIL-CLOSED: the script no-ops unless CLAUDE_RELOG_ENABLED=1 AND the
       account pool has been populated (registry + Bitwarden 'claude-acct-<label>'
       secrets). With the env var unset (as shipped) every run logs "disabled"
       and touches NOTHING — so loading this job never mutates live credentials
       before Athos has opted in. To enable: register accounts, then add
       CLAUDE_RELOG_ENABLED=1 to this plist's EnvironmentVariables and reload.
       See docs/claude-account-relog.md. -->

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/claude-account-relog.sh</string>
    <string>auto</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/athos/gt/.gascity-gastown-hq</string>

  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/claude-account-relog-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/claude-account-relog-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
    <!-- Fail-closed: leave CLAUDE_RELOG_ENABLED UNSET until the account pool is
         populated and Athos opts in. Add <key>CLAUDE_RELOG_ENABLED</key><string>1</string>
         here to arm auto-relog. -->
  </dict>
</dict>
</plist>
