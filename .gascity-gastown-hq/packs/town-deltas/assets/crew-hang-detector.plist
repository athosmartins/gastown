<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.crew-hang-detector</string>

  <!-- Runs every 300 seconds (5 minutes). Lists active persistent CREW sessions
       (name==template OR name startswith "<template>-gawisp"), peeks each, and
       tracks any whose ACTIVE-WORK pane is byte-frozen across passes (the hang
       signature — see crew-hang-detector.sh header for why last_active is NOT a
       usable signal). Recovers a sustained freeze via the existing safe
       shutdown-dance path:
         frozen > STALE_SEC (600s)     -> courtesy nudge probe
         frozen > ESCALATE_SEC (1200s) -> escalate
       Escalation is gated by WARRANT_ENABLED (below):
         WARRANT_ENABLED=0 (default)   -> NOTIFY a human (non-destructive)
         WARRANT_ENABLED=1             -> file a `warrant` bead for the dog pool;
            the dog runs mol-shutdown-dance (3 interrogations / 420s) and only
            kills if the agent never proves ALIVE; the reconciler then restarts
            the pinned session. Closes the crew-coverage gap (ga-khuz1) left by
            the suspended deacon and the gate/pilot-only guardian (ga-0wxg).
       Idle crew never enter the candidate set (no spinner), so they are never
       flagged — this is the ga-6i82w/ga-yqcdj fix for v1's idle false-positive.

       DO NOT load this plist unsupervised on first run.
       Supervised first-dispatch procedure:
         1. DRY_RUN=1 bash crew-hang-detector.sh   # verify candidate detection
         2. bash crew-hang-detector.sh             # single supervised real pass
         3. launchctl bootstrap gui/$(id -u) \
              ~/Library/LaunchAgents/com.gascity.crew-hang-detector.plist
       The DESTRUCTIVE auto-recovery (warrant -> shutdown-dance -> kill/restart)
       stays OFF until the freeze signal is validated against a captured real
       hang. To enable it then, flip WARRANT_ENABLED 0 -> 1 below and reload.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/packs/town-deltas/assets/crew-hang-detector.sh</string>
  </array>

  <key>StartInterval</key><integer>300</integer>

  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/crew-hang-detector-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/crew-hang-detector-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
    <!-- Destructive auto-recovery gate. 0 = notify-only (safe default until the
         freeze signal is validated against a real hang). Flip to 1 to enable
         warrant -> shutdown-dance -> kill/restart, then reload this agent. -->
    <key>WARRANT_ENABLED</key>
    <string>0</string>
  </dict>
</dict>
</plist>
