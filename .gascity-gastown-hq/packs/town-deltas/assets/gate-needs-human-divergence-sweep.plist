<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.gate-needs-human-divergence-sweep</string>

  <!-- Gate needs-human divergence sweep (ga-u4yi, 2026-07-14). A branch parked
       at gate:needs-human (auto-fix cap exhausted, or an ga-acb circuit-break
       in quality-gate-dispatcher.sh) is a SILENT PARK, not a queue — the Pilot
       will never re-dispatch it and the guard silently parks every
       resubmission. Nothing previously watched whether origin/<default>
       gained commits on the SAME files the parked branch touches while it
       sat there. thies-wa's branch rotted 20h; by the time a human looked,
       main had 7 conflicting commits on the same files and the branch was
       unmergeable — the whole phase had to be re-anchored. This sweep
       snapshots a baseline SHA + touched-files list the first time it sees a
       gate:needs-human bead, then on every later run checks for new commits
       on those files (ga-u4yi's suggested cheap signal: `git log main`
       scoped to `<files>` via git's path-separator flag) and escalates —
       label + comment the bead, mail BOTH the
       author and the Mayor (durable), ntfy P4 — while the branch is
       presumably still rebaseable. Runs once per StartInterval and exits (not
       resident). Idempotent; presence-pruned (drops a bead as soon as it
       leaves gate:needs-human) with a 30d retention backstop; per-bead
       rate-limited escalation. Companion fix: quality-gate-dispatcher.sh now
       also mails the AUTHOR (not just the Mayor) at the moment a bead first
       transitions into gate:needs-human. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/packs/town-deltas/assets/gate-needs-human-divergence-sweep.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/athos/gt/.gascity-gastown-hq</string>

  <!-- Sweep cadence: every 30 min, matching the sibling gate-merge-survival-
       sweep.sh — a parked branch degrades over hours, not minutes, so 30 min
       is ample to catch a collision early while still comfortably rebaseable.
       RunAtLoad fires an immediate sweep on load. -->
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/gate-needs-human-divergence-sweep-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/gate-needs-human-divergence-sweep-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
    <key>DIVERGENCE_LOG_STDOUT</key>
    <string>1</string>
  </dict>
</dict>
</plist>
