<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.skill-audit</string>

  <!-- Periodic skill-publish integrity check. Read-only auditor: emits the
       drift=0 / off-path dashboard metric to .gc/state/skill-drift.json.
       Never touches skill sinks, city.toml, pack.toml, or gc reload — drain-safe. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/skill-audit-emit.sh</string>
  </array>

  <!-- Run every 5 minutes (off the :00 mark to avoid fleet-wide pileups). -->
  <key>StartInterval</key><integer>300</integer>

  <!-- Run once when loaded so the metric file exists immediately. -->
  <key>RunAtLoad</key><true/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/skill-audit-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/skill-audit-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
    <key>GC</key>
    <string>gc</string>
  </dict>

  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
