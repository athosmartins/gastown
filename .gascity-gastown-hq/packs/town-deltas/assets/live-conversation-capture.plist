<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.live-conversation-capture</string>

  <!-- ga-esorlre.2: every 120 s records, in the session bead of the Mayor and of each named crew, the id of the conversation ALIVE in its pane
       (session.live_conversation_id / _at), so a reboot can bring each one back in the conversation the Athos was using. Contract and states: header of
       scripts/live-conversation-capture.py. A pass ends in <= 90 s (LCC_BUDGET_S) under an instance lock and prints ONE summary line to the .out.
       INSTALL on the mini (until it is loaded the watchdog PRESENCE-DRIFT flags this file): first `/usr/bin/python3 scripts/live-conversation-capture.py --dry-run`
       (`alvos=` must list the Mayor and every crew), then cp this plist to ~/Library/LaunchAgents/ and launchctl bootstrap gui/$(id -u) it.
       ROLLBACK: touch .gc/live-conversation-capture.off (next pass, no launchctl) or launchctl bootout. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/scripts/live-conversation-capture.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/athos/gt/.gascity-gastown-hq</string>

  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/live-conversation-capture-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/live-conversation-capture-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
  </dict>
</dict>
</plist>
