<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.bd-metrics-off-alarm</string>

  <!-- ga-8g9ki5: tripwire for bd's anonymous telemetry getting re-enabled --
       see bd-metrics-disable-env.plist and scripts/bd-metrics-off-alarm.sh for
       the full incident context (ga-cpqxf3: eventsData grew to 16GB unpruned,
       hit the FS's 65535-hardlink ceiling, hung every spawned bd send-metrics
       child in kernel-level uninterruptible wait — no application timeout can
       interrupt that state). Checks bd's reported metrics STATE only, never
       enumerates eventsData itself (that enumeration is exactly what hangs). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/packs/town-deltas/assets/scripts/bd-metrics-off-alarm.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/athos/gt/.gascity-gastown-hq</string>

  <!-- 900 = every 15 min. Not as tight as dolt-disk-floor-guard's 5 min --
       unlike active disk depletion, a metrics-state flip is a discrete config
       change, not a fast-worsening measurement, and the alarm is edge-triggered
       (fires once on the transition) so a longer interval just delays first
       detection slightly, not detection reliability. -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/bd-metrics-off-alarm-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/bd-metrics-off-alarm-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
  </dict>
</dict>
</plist>
