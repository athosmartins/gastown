<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gascity.refino-gate-dispatcher</string>

  <!-- Refino quality gate (ga-gpr2v). Runs every 3 minutes. Picks up the oldest
       story:refino-review story, spawns one Sonnet reviewer, and on the verdict
       promotes to story:needs-approval (PASS), bounces back to the refiner (FAIL),
       or escalates to Athos (round limit). One story per sweep; launchd waits for
       the previous run to finish before re-firing, so a long review never
       double-fires. Staggered 60s off the code gate's :00 cadence to spread the
       Dolt boot-herd from concurrent reviewer `gc prime` calls. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/athos/gt/.gascity-gastown-hq/packs/town-deltas/assets/refino-gate-dispatcher.sh</string>
  </array>

  <key>StartInterval</key><integer>180</integer>

  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/refino-gate-dispatcher-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/athos/gt/.gascity-gastown-hq/.gc/logs/refino-gate-dispatcher-launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/athos/go/bin:/Users/athos/.local/bin</string>
    <key>HOME</key>
    <string>/Users/athos</string>
    <key>GC_CITY_PATH</key>
    <string>/Users/athos/gt/.gascity-gastown-hq</string>
  </dict>
</dict>
</plist>
